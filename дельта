		S.footsteps=t.footsteps or false; S.footstepSize=t.footstepSize or 4

		S.playerList=t.playerList or false

		S.fullbright=t.fullbright or false; S.noFog=t.noFog or false

		S.baseFov=t.baseFov or 70; S.zoomFov=t.zoomFov or 30
		S.zoomKey = Enum.KeyCode[t.zoomKeyName or "Z"] or Enum.KeyCode.Z

		S.vmEnabled=t.vmEnabled or false; S.vmTransparency=t.vmTransparency or 0
		S.vmOffsetX=t.vmOffsetX or 0; S.vmOffsetY=t.vmOffsetY or 0; S.vmOffsetZ=t.vmOffsetZ or 0
		S.vmColor = Color3.new(t.vmColorR or 0.31, t.vmColorG or 0.61, t.vmColorB or 0.47)

		S.wpnEnabled=t.wpnEnabled or false; S.wpnTransparency=t.wpnTransparency or 0
		S.wpnColor = Color3.new(t.wpnColorR or 1, t.wpnColorG or 1, t.wpnColorB or 1)

		S.invEnabled=t.invEnabled or false
		S.invKey = Enum.KeyCode[t.invKeyName or "X"] or Enum.KeyCode.X
		S.invShowName=t.invShowName ~= false; S.invShowValue=t.invShowValue ~= false
		S.invShowFull=t.invShowFull or false; S.invIncludeCorpse=t.invIncludeCorpse or false
		S.invMaxAngleDeg=t.invMaxAngleDeg or 45; S.invMaxDistance=t.invMaxDistance or 500
		S.invShowAttach=t.invShowAttach ~= false

		Aimbot.stop()
		if S.aimEnabled then Aimbot.start() end
	end

	function self.save(slot)
		local name = "slot" .. tostring(slot)
		local data = self.collect()
		local ok = SaveFile(name, HttpService:JSONEncode(data))
		local remote = ReplicatedStorage:FindFirstChild("LirpConfigRemote")
		if remote then
			pcall(function() remote:InvokeServer("save", name, data) end)
			pcall(function() remote:InvokeServer("setLastAuto", name) end)
		end
		SaveFile("AutoLoadConfig", name)
		print("[Config] SAVE slot" .. slot .. (ok and " (file)" or ""))
		return true
	end

	function self.load(slot)
		local name = "slot" .. tostring(slot)
		local data = nil
		local raw = LoadFile(name)
		if raw then
			local ok, dec = pcall(function() return HttpService:JSONDecode(raw) end)
			if ok and type(dec) == "table" then data = dec end
		end
		if not data then
			local remote = ReplicatedStorage:FindFirstChild("LirpConfigRemote")
			if remote then
				local ok, result = pcall(function() return remote:InvokeServer("load", name) end)
				if ok and type(result) == "table" then data = result end
			end
		end
		if not data then warn("[Config] slot" .. slot .. " empty"); return false end
		self.apply(data)
		SaveFile("AutoLoadConfig", name)
		print("[Config] LOAD slot" .. slot)
		return true
	end

	function self.autoLoad()
		local lastAuto = nil
		if isfile and readfile then
			if isfile("AutoLoadConfig.txt") then lastAuto = readfile("AutoLoadConfig.txt") end
		elseif ReplicatedStorage:FindFirstChild("LirpConfigRemote") then
			local ok, result = pcall(function() return ReplicatedStorage.LirpConfigRemote:InvokeServer("lastAuto") end)
			if ok and type(result) == "string" then lastAuto = result end
		end
		if not lastAuto or lastAuto == "" then return end
		local data = nil
		local raw = LoadFile(lastAuto)
		if raw then
			local ok, dec = pcall(function() return HttpService:JSONDecode(raw) end)
			if ok and type(dec) == "table" then data = dec end
		end
		if not data then
			local remote = ReplicatedStorage:FindFirstChild("LirpConfigRemote")
			if remote then
				local ok, result = pcall(function() return remote:InvokeServer("load", lastAuto) end)
				if ok and type(result) == "table" then data = result end
			end
		end
		if data then
			self.apply(data)
			print("[Config] AutoLoad: " .. lastAuto)
		end
	end

	return self
end)()

