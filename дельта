UserInputService.InputBegan:Connect(function(input, gp)
	if pendingKeybind then
		local ok = pendingKeybind(input)
		if ok then
			pendingKeybind = nil
			return
		end
	end

	if gp then return end

	if H.matchesHold(input) then isHolding = true end
	if input.KeyCode == S.invKey then isHoldingInv = true end

	if input.KeyCode == Enum.KeyCode.RightShift then
		setMenuVisible(not menuOpen)
	end
end)

UserInputService.InputEnded:Connect(function(input, gp)
	if H.matchesHold(input) then
		isHolding = false
	end
	if input.KeyCode == S.invKey then
		isHoldingInv = false
	end
end)

-- Keep mouse unlocked while menu open
RunService.RenderStepped:Connect(function()
	if menuOpen then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end
end)

-- Respawn
Players.PlayerAdded:Connect(function(plr)
	if plr == LocalPlayer then return end
	plr.CharacterAdded:Connect(function(char)
		if S.playerGlow then Glow.applyToModel(char) end
		if S.espBox      then ESP.createESP(plr) end
		if S.espSkeleton then ESP.createSkeleton(plr) end
		if S.espTracer   then ESP.createTracer(plr) end
	end)
	if S.playerGlow and plr.Character then Glow.applyToModel(plr.Character) end
end)
Players.PlayerRemoving:Connect(function(plr)
	ESP.clearESP(plr); ESP.clearSkeleton(plr); ESP.clearTracer(plr)
	if plr.Character then Glow.removeFromModel(plr.Character) end
end)
LocalPlayer.CharacterAdded:Connect(function()
	ESP.restartAll()
end)

