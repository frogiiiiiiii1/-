        local closeB = Instance.new("TextButton", popup)
        closeB.Size = UDim2.fromOffset(60, 22); closeB.Position = UDim2.fromOffset(10, 88)
        closeB.BackgroundColor3 = Color3.fromRGB(120,50,60); closeB.BorderSizePixel = 0
        closeB.Text = "Close"; closeB.TextColor3 = C.text; closeB.Font = Enum.Font.GothamBold; closeB.TextSize = 11
        closeB.ZIndex = 5001
        Instance.new("UICorner", closeB).CornerRadius = UDim.new(0, 5)
        closeB.MouseButton1Click:Connect(function() popup:Destroy() end)

        local clickConn
        clickConn = UIS.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                task.wait(0.1)
                if popup and popup.Parent then popup:Destroy() end
                if clickConn then clickConn:Disconnect() end
            end
        end)
    end)
end

--// ==================== FULL UNLOAD ====================
local function fullUnload()
    ACTIVE = false
    resetAllHeads()
    applyXray(false)
    setFullbright(false)
    setGrass(true)
    setLeaves(true)
    if S.FreeCam then
        S.FreeCam = false
        RunService:UnbindFromRenderStep("GootFreeCam")
        Camera.CameraType = Enum.CameraType.Custom
    end
    RunService:UnbindFromRenderStep("GootFOV")
    if camMT and oldNewIndex then
        pcall(function()
            setreadonly(camMT, false)
            camMT.__newindex = oldNewIndex
            setreadonly(camMT, true)
        end)
    end
    Camera.FieldOfView = ORIGINAL_FOV
    for _, d in pairs(ESPData) do
        pcall(function() d.box:Remove() end)
        pcall(function() d.outline:Remove() end)
        pcall(function() d.text:Remove() end)
        pcall(function() d.weaponText:Remove() end)
        pcall(function() d.tracer:Remove() end)
        for _, s in ipairs(d.skeletonLines) do pcall(function() s.line:Remove() end) end
    end
    ESPData = {}
    for _, d in pairs(oreESP) do pcall(function() d.Text:Remove() end) end
    oreESP = {}
    for _, d in pairs(CorpseData) do pcall(function() d.drawing:Remove() end) end
    CorpseData = {}
    for _, r in ipairs(RaidList) do pcall(function() r.text:Remove() end) end
    RaidList = {}
    for _, d in pairs(AirdropData) do pcall(function() d.drawing:Remove() end) end
    AirdropData = {}
    for _, d in pairs(VehicleESP) do pcall(function() d.Drawing:Remove() end) end
    VehicleESP = {}
    Camera.CameraType = Enum.CameraType.Custom
    Gui:Destroy()
    WatermarkGui:Destroy()
    UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
    print("[GootHub] Fully unloaded.")
end

Close.MouseButton1Click:Connect(fullUnload)

