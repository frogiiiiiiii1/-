UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == S.keybinds.Menu then
        local nowEnabled = not Gui.Enabled
        if nowEnabled then
            Gui.Enabled = true
            Main.Size = UDim2.new(0, 0, 0, 0)
            Main.Position = UDim2.new(0.5, 0, 0.5, 0)
            TweenService:Create(Main, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, math.floor(580 * S.MenuScale), 0, math.floor(440 * S.MenuScale)),
                Position = UDim2.new(0.5, -math.floor(290 * S.MenuScale), 0.5, -math.floor(220 * S.MenuScale)),
            }):Play()
            UIS.MouseBehavior = Enum.MouseBehavior.Default
        else
            local t = TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                Position = UDim2.new(0.5, 0, 0.5, 0),
            })
            t:Play()
            t.Completed:Connect(function() Gui.Enabled = false end)
            UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
        end
        return
    end
    if not ACTIVE then return end
    if input.KeyCode == S.keybinds.XRay then
        S.XRay = not S.XRay
        applyXray(S.XRay)
    elseif input.KeyCode == S.keybinds.FreeCam then
        toggleFreeCam()
    end
end)

