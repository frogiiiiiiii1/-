local function getWeaponName(model)
    local hand = model:FindFirstChild("HandModel")
    if not hand then return "None" end
    local best, bestScore = nil, 0
    for name, parts in pairs(WEAPONS) do
        local score = 0
        for _, p in ipairs(parts) do
            if hand:FindFirstChild(p, true) then score = score + 1 end
        end
        if score > bestScore then bestScore = score; best = name end
    end
    return best or "None"
end

