local ACTIVE = true

--// ==================== FOV + ZOOM ====================
local ORIGINAL_FOV = Camera.FieldOfView or 70
local currentFOV = ORIGINAL_FOV

local function getTargetFOV()
    if not ACTIVE then return ORIGINAL_FOV end
    local baseFOV = S.FOVChanger and S.CustomFOV or ORIGINAL_FOV
    if zoomHeld then return math.min(baseFOV, zoomFOV) end
    return baseFOV
end

local camMT = getrawmetatable(game)
local oldNewIndex = camMT.__newindex
setreadonly(camMT, false)
camMT.__newindex = newcclosure(function(self, key, value)
    if ACTIVE and self == Camera and key == "FieldOfView" then
        return oldNewIndex(self, key, getTargetFOV())
    end
    return oldNewIndex(self, key, value)
end)
setreadonly(camMT, true)

RunService:BindToRenderStep("GootFOV", 2000, function(dt)
    if not ACTIVE then return end
    local target = getTargetFOV()
    if math.abs(currentFOV - target) < 0.1 then
        currentFOV = target
    else
        local speed = 220 * dt
        currentFOV = currentFOV + math.sign(target - currentFOV) * math.min(speed, math.abs(target - currentFOV))
    end
    oldNewIndex(Camera, "FieldOfView", currentFOV)
end)

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if not ACTIVE then return end
    if input.KeyCode == S.keybinds.Zoom then zoomHeld = true end
end)
UIS.InputEnded:Connect(function(input)
    if input.KeyCode == S.keybinds.Zoom then zoomHeld = false end
end)

--// ==================== PLAYER ESP ====================
local ESPData = {}
local WeaponCache = {}

local function makeESP(model)
    if ESPData[model] then return end
    local head, torso = getHeadTorso(model)
    if not head or not torso then return end

    local box = Drawing.new("Square"); box.Thickness=1; box.Filled=false; box.Visible=false
    local outline = Drawing.new("Square"); outline.Thickness=1; outline.Filled=false; outline.Color=Color3.new(0,0,0); outline.Visible=false
    local text = Drawing.new("Text"); text.Size=16; text.Center=true; text.Outline=true; text.OutlineColor=Color3.new(0,0,0); text.Visible=false
    local weaponText = Drawing.new("Text"); weaponText.Size=16; weaponText.Center=true; weaponText.Outline=true; weaponText.OutlineColor=Color3.new(0,0,0); weaponText.Visible=false
    local tracer = Drawing.new("Line"); tracer.Thickness=1; tracer.Visible=false

    local skelLines = {}
    for _, pair in ipairs(SKELETON) do
        local line = Drawing.new("Line"); line.Thickness=1.5; line.Visible=false
        table.insert(skelLines, {line=line, a=pair[1], b=pair[2]})
    end

    ESPData[model] = {box=box, outline=outline, text=text, weaponText=weaponText, tracer=tracer, head=head, torso=torso, skeletonLines=skelLines}

    model.Destroying:Connect(function()
        pcall(function() box:Remove() end)
        pcall(function() outline:Remove() end)
        pcall(function() text:Remove() end)
        pcall(function() weaponText:Remove() end)
        pcall(function() tracer:Remove() end)
        for _, s in ipairs(skelLines) do pcall(function() s.line:Remove() end) end
        ESPData[model] = nil
    end)
end

for _, obj in ipairs(Workspace:GetChildren()) do
    if obj:IsA("Model") then makeESP(obj) end
end
Workspace.ChildAdded:Connect(function(obj)
    if obj:IsA("Model") then makeESP(obj) end
end)

