RunService.RenderStepped:Connect(function()
    if not ACTIVE or not S.ESP then
        for _, d in pairs(ESPData) do
            d.box.Visible=false; d.outline.Visible=false; d.text.Visible=false
            d.weaponText.Visible=false; d.tracer.Visible=false
            for _, s in ipairs(d.skeletonLines) do s.line.Visible=false end
        end
        return
    end
    local camPos = Camera.CFrame.Position
    for model, d in pairs(ESPData) do
        local visible = true
        local head, torso = d.head, d.torso
        if not head or not torso or not head.Parent or not torso.Parent then
            head, torso = getHeadTorso(model)
            d.head, d.torso = head, torso
            if not head or not torso then visible = false end
        end
        if visible and S.SleeperCheck and isSleeper(model) then visible = false end
        local centerPos, dist
        if visible then
            centerPos = (head.Position + torso.Position) * 0.5
            dist = (centerPos - camPos).Magnitude
            if dist >= S.ESPMaxDist then visible = false end
        end
        local screenPos, onScreen
        if visible then
            screenPos, onScreen = Camera:WorldToViewportPoint(centerPos)
            if not onScreen then visible = false end
        end
        if not visible then
            d.box.Visible=false; d.outline.Visible=false; d.text.Visible=false
            d.weaponText.Visible=false; d.tracer.Visible=false
            for _, s in ipairs(d.skeletonLines) do s.line.Visible=false end
            continue
        end
        local scale = 1000 / (dist * 2) / math.tan(math.rad(Camera.FieldOfView / 1.7))
        local w = math.clamp(math.floor(6.5 * scale), 10, 600)
        local h = math.clamp(math.floor(9.5 * scale), 14, 800)
        local x = screenPos.X - w/2
        local y = screenPos.Y - h/3.5
        local isP = isPlayer(model)
        local boxColor = isP and S.espColors.Box or Color3.fromRGB(0,150,255)
        local txtColor = isP and S.espColors.Text or Color3.fromRGB(0,150,255)
