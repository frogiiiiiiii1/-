local PITCH_LIMIT = math.rad(80)
local freecamPos, freecamYaw, freecamPitch
local keysDown = {}
local keyMap = {
    [Enum.KeyCode.W] = Vector3.new(0,0,-1),
    [Enum.KeyCode.S] = Vector3.new(0,0,1),
    [Enum.KeyCode.A] = Vector3.new(-1,0,0),
    [Enum.KeyCode.D] = Vector3.new(1,0,0),
    [Enum.KeyCode.Space] = Vector3.new(0,1,0),
    [Enum.KeyCode.LeftShift] = Vector3.new(0,-1,0),
}

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if not ACTIVE then return end
    if keyMap[input.KeyCode] then keysDown[input.KeyCode] = true end
end)
UIS.InputEnded:Connect(function(input)
    if keyMap[input.KeyCode] then keysDown[input.KeyCode] = false end
end)

local function toggleFreeCam()
    if S.FreeCam then
        S.FreeCam = false
        RunService:UnbindFromRenderStep("GootFreeCam")
        Camera.CameraType = Enum.CameraType.Custom
    else
        S.FreeCam = true
        local cf = Camera.CFrame
        freecamPos = cf.Position
        local look = cf.LookVector
        freecamPitch = math.asin(-look.Y)
        freecamYaw = math.atan2(-look.X, -look.Z)
        Camera.CameraType = Enum.CameraType.Scriptable
        RunService:BindToRenderStep("GootFreeCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
            if not ACTIVE then return end
            local delta = UIS:GetMouseDelta()
            freecamYaw = freecamYaw - delta.X * 0.002
            freecamPitch = math.clamp(freecamPitch - delta.Y * 0.002, -PITCH_LIMIT, PITCH_LIMIT)
            local cf2 = CFrame.Angles(0, freecamYaw, 0) * CFrame.Angles(freecamPitch, 0, 0)
            local dir = Vector3.zero
            for k, v in pairs(keyMap) do if keysDown[k] then dir = dir + v end end
            if dir.Magnitude > 0 then
                dir = cf2:VectorToWorldSpace(dir).Unit
                freecamPos = freecamPos + dir * S.FreeCamSpeed * dt
            end
            Camera.CFrame = CFrame.new(freecamPos) * cf2
        end)
    end
end

