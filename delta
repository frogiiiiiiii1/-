local aimHeadEnabled = false
local aimBodyEnabled = false
local aimHeartbeat

local function getClosestTarget()
	local camPos = Camera.CFrame.Position
	local camDir = Camera.CFrame.LookVector
	local bestTarget = nil
	local bestModel = nil
	local bestName = nil
	local bestScore = math.huge

	local targets = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local char = player.Character
		if char then
			local head = char:FindFirstChild("Head")
			local root = char:FindFirstChild("HumanoidRootPart")
			local humanoid = char:FindFirstChild("Humanoid")
			if head and root and humanoid and humanoid.Health > 0 then
				table.insert(targets, {model = char, root = root, head = head, humanoid = humanoid, name = player.Name})
			end
		end
	end
	for _, npc in ipairs(activeNPCs) do
		if npc and npc.Parent then
			local head = npc:FindFirstChild("Head")
			local root = npc:FindFirstChild("HumanoidRootPart")
			local humanoid = npc:FindFirstChild("Humanoid")
			if head and root and humanoid and humanoid.Health > 0 then
				table.insert(targets, {model = npc, root = root, head = head, humanoid = humanoid, name = npc.Name})
			end
		end
	end

	for _, t in ipairs(targets) do
		if aimVisibleOnly and not isTargetVisible(t.root.Position, t.model) then continue end

		local targetPoint = aimHeadEnabled and t.head.Position or t.root.Position
		if aimPrediction > 0 then
			local velocity = t.root.Velocity
			targetPoint = targetPoint + velocity * aimPrediction * 0.2
		end

		local dirToTarget = (targetPoint - camPos).Unit
		local angle = math.acos(math.clamp(camDir:Dot(dirToTarget), -1, 1))
		local angleDeg = math.deg(angle)
		local dist = (targetPoint - camPos).Magnitude

		local score
		if aimPriority == "Distance" then score = dist else score = angleDeg end

		if angleDeg < (aimFovAngle / 2) and score < bestScore then
			bestScore = score
			bestTarget = targetPoint
			bestModel = t.model
			bestName = t.name
		end
	end

	return bestTarget, bestModel, bestName
end

local function aimUpdate()
	if not (aimHeadEnabled or aimBodyEnabled) then return end
	if not isRightMouseDown then
		aimTargetNameText.Visible = false
		return
	end
	local targetPos, targetModel, targetName = getClosestTarget()
	aimTargetPos = targetPos
	aimTargetModel = targetModel
	aimTargetName = targetName
	if targetPos then
		Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, targetPos), aimSmoothing)
		if isTargetVisible(targetPos, targetModel) then
			aimStatusYes.Visible = true
			aimStatusNo.Visible = false
		else
			aimStatusYes.Visible = false
			aimStatusNo.Visible = true
		end
		aimTargetNameText.Visible = true
		aimTargetNameText.Text = targetName or "???"
	else
		aimStatusYes.Visible = false
		aimStatusNo.Visible = false
		aimTargetNameText.Visible = false
	end
end

local function startAim()
	if aimHeartbeat then aimHeartbeat:Disconnect() end
	aimHeartbeat = RunService.Heartbeat:Connect(aimUpdate)
	aimFovCircle.Visible = true
	updateFovCircle()
end

local function stopAim()
	if aimHeartbeat then aimHeartbeat:Disconnect(); aimHeartbeat = nil end
	aimFovCircle.Visible = false
	aimStatusYes.Visible = false
	aimStatusNo.Visible = false
	aimTargetNameText.Visible = false
	aimTargetModel = nil
	aimTargetPos = nil
	aimTargetName = nil
end

