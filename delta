	NPC_SKELETON_COLOR = s.npcSkeletonColor or NPC_SKELETON_COLOR
	NPC_TRACER_COLOR = s.npcTracerColor or NPC_TRACER_COLOR
	updateAllESPColor(); updateAllSkeletonColor(); updateAllTracerColor()
	updateAllNPCESPColor(); updateAllNPCSkeletonColor(); updateAllNPCTracerColor()
	aimFovCircle.Color = AIM_FOV_COLOR
	basePlayerFOV = s.basePlayerFOV or 70
	zoomFOV = s.zoomFOV or 30
	aimFovAngle = s.aimFovAngle or 90
	aimSmoothing = s.aimSmoothing or 0.3
	aimPrediction = s.aimPrediction or 0
	aimVisibleOnly = s.aimVisibleOnly or false
	aimPriority = s.aimPriority or "FOV"
	aimHeadEnabled = s.aimHeadEnabled or false
	aimBodyEnabled = s.aimBodyEnabled or false
	espEnabled = s.espEnabled or false
	skeletonEnabled = s.skeletonEnabled or false
	tracerEnabled = s.tracerEnabled or false
	npcEspEnabled = s.npcEspEnabled or false
	npcSkeletonEnabled = s.npcSkeletonEnabled or false
	npcTracerEnabled = s.npcTracerEnabled or false
	fullbrightEnabled = s.fullbrightEnabled or false
	setFullbright(fullbrightEnabled)
	noFogEnabled = s.noFogEnabled or false
	setNoFog(noFogEnabled)
	playerListEnabled = s.playerListEnabled or false
	if playerListEnabled then createPlayerList() else destroyPlayerList() end
	playerGlowEnabled = s.playerGlowEnabled or false
	npcGlowEnabled = s.npcGlowEnabled or false
	glowTransparency = s.glowTransparency or 0.5
	updateGlow()
	footstepsEnabled = s.footstepsEnabled or false
	showHeldItemPlayers = s.showHeldItemPlayers or false
	showHeldItemNPCs = s.showHeldItemNPCs or false
	if aimHeadEnabled or aimBodyEnabled then startAim() else stopAim() end
	updateFovCircle()
end

