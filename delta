local function updateFovCircle()
	if not aimFovCircle.Visible then return end
	local screenSize = Camera.ViewportSize
	local center = Vector2.new(screenSize.X / 2, screenSize.Y / 2)
	local verticalFov = math.rad(Camera.FieldOfView)
	local screenDist = (screenSize.Y / 2) / math.tan(verticalFov / 2)
	local aimRad = math.rad(aimFovAngle)
	local radius = screenDist * math.tan(aimRad / 2)
	aimFovCircle.Position = center
	aimFovCircle.Radius = radius
	local statusPos = Vector2.new(center.X, center.Y + radius + 16)
	aimStatusYes.Position = statusPos
	aimStatusNo.Position = statusPos
	aimTargetNameText.Position = Vector2.new(center.X, center.Y + radius + 34)
end

Camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateFovCircle)
Camera:GetPropertyChangedSignal("FieldOfView"):Connect(updateFovCircle)

-- ====================== ВИДИМОСТЬ ЦЕЛИ ======================
local function isTargetVisible(targetPos, targetModel)
	if not targetPos or not targetModel then return false end
	local camPos = Camera.CFrame.Position
	local rayOrigin = camPos
	local rayDirection = (targetPos - camPos).Unit * 1000
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Blacklist
	local localChar = LocalPlayer.Character
	if localChar then
		rayParams.FilterDescendantsInstances = {localChar}
	else
		rayParams.FilterDescendantsInstances = {}
	end
	local result = Workspace:Raycast(rayOrigin, rayDirection, rayParams)
	if result then
		local hitPart = result.Instance
		if hitPart:IsDescendantOf(targetModel) then
			return true
		else
			return false
		end
	else
		return true
	end
end

-- ====================== FULLBRIGHT ======================
local fullbrightEnabled = false
local originalLightingProps = {}

local function saveLighting()
	originalLightingProps = {
		GlobalShadows = Lighting.GlobalShadows,
		Brightness = Lighting.Brightness,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		FogEnd = Lighting.FogEnd,
		FogStart = Lighting.FogStart,
		FogColor = Lighting.FogColor,
		ClockTime = Lighting.ClockTime,
		TimeOfDay = Lighting.TimeOfDay,
	}
end

local function applyFullbright()
	Lighting.GlobalShadows = false
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(178, 178, 178)
	Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
	Lighting.FogEnd = 100000
	Lighting.FogStart = 0
	Lighting.FogColor = Color3.fromRGB(255, 255, 255)
	Lighting.ClockTime = 14
end

local function restoreLighting()
	for prop, value in pairs(originalLightingProps) do
		if Lighting[prop] ~= nil then
			Lighting[prop] = value
		end
	end
end

local function setFullbright(enabled)
	fullbrightEnabled = enabled
	if enabled then
		saveLighting()
		applyFullbright()
	else
		restoreLighting()
	end
end

-- ====================== NO FOG ======================
local function setNoFog(enabled)
	noFogEnabled = enabled
	if enabled then
		originalFogStart = Lighting.FogStart
		originalFogEnd = Lighting.FogEnd
		Lighting.FogStart = 0
		Lighting.FogEnd = 100000
	else
		if originalFogStart ~= nil then
			Lighting.FogStart = originalFogStart
			Lighting.FogEnd = originalFogEnd
		end
	end
end

