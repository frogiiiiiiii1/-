local function applySettings(s)
	if not s then return end
	ESP_COLOR = s.espColor or ESP_COLOR
	SKELETON_COLOR = s.skeletonColor or SKELETON_COLOR
	TRACER_COLOR = s.tracerColor or TRACER_COLOR
	AIM_FOV_COLOR = s.aimFovColor or AIM_FOV_COLOR
