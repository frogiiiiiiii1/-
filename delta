-- ===== ФУНКЦИЯ СОЗДАНИЯ КНОПОК =====
local function createButton(text, link, yOffset)
    local Button = Instance.new("TextButton")
    Button.Name = "CopyButton"
    Button.Parent = MainFrame
    Button.Size = UDim2.new(0.82, 0, 0, 55)
    Button.Position = UDim2.new(0.09, 0, 0, yOffset)
    Button.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
    Button.Text = text
    Button.TextColor3 = Color3.fromRGB(220, 220, 255)
    Button.TextSize = 17
    Button.Font = Enum.Font.GothamMedium
    Button.BorderSizePixel = 0
    Button.AutoButtonColor = false
    Button.ZIndex = 11

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 10)
    ButtonCorner.Parent = Button

    local ButtonStroke = Instance.new("UIStroke")
    ButtonStroke.Color = Color3.fromRGB(90, 90, 130)
    ButtonStroke.Thickness = 1
    ButtonStroke.Transparency = 0.4
    ButtonStroke.Parent = Button

    Button.MouseEnter:Connect(function()
        game:GetService("TweenService"):Create(
            Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(70, 70, 100), TextColor3 = Color3.fromRGB(255, 255, 255)}
        ):Play()
        game:GetService("TweenService"):Create(
            ButtonStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(150, 130, 255), Transparency = 0}
        ):Play()
    end)
    Button.MouseLeave:Connect(function()
        game:GetService("TweenService"):Create(
            Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 65), TextColor3 = Color3.fromRGB(220, 220, 255)}
        ):Play()
        game:GetService("TweenService"):Create(
            ButtonStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(90, 90, 130), Transparency = 0.4}
        ):Play()
    end)

    Button.MouseButton1Click:Connect(function()
        if setclipboard then
            setclipboard(link)
            local oldText = Button.Text
            Button.Text = "✅ Copied! | Скопировано!"
            Button.TextColor3 = Color3.fromRGB(100, 255, 120)
            task.wait(1.5)
            if Button.Parent then
                Button.Text = oldText
                Button.TextColor3 = Color3.fromRGB(220, 220, 255)
            end
        else
            Button.Text = "❌ Copy failed | Ошибка копирования"
            Button.TextColor3 = Color3.fromRGB(255, 100, 100)
            task.wait(1.5)
            Button.Text = text
            Button.TextColor3 = Color3.fromRGB(220, 220, 255)
        end
    end)
end

