-- ====================== GLOW ======================
local function clearAllGlow()
	for _, hl in pairs(activeHighlights) do hl:Destroy() end
	activeHighlights = {}
end

local function applyGlowToModel(model)
	if not model then return end
	if activeHighlights[model] then activeHighlights[model]:Destroy(); activeHighlights[model] = nil end
	local hl = Instance.new("Highlight")
	hl.FillTransparency = 1
	hl.OutlineColor = GLOW_COLOR
	hl.OutlineTransparency = glowTransparency
	hl.Parent = model
	activeHighlights[model] = hl
end

local function removeGlowFromModel(model)
	if activeHighlights[model] then activeHighlights[model]:Destroy(); activeHighlights[model] = nil end
end

local function updateGlow()
	for _, hl in pairs(activeHighlights) do hl.OutlineTransparency = glowTransparency end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == LocalPlayer then continue end
		local char = plr.Character
		if playerGlowEnabled then
			if char and not activeHighlights[char] then applyGlowToModel(char) end
		else
			if char then removeGlowFromModel(char) end
		end
	end
	for _, npc in ipairs(activeNPCs) do
		if npcGlowEnabled then
			if npc and npc.Parent and not activeHighlights[npc] then applyGlowToModel(npc) end
		else
			if npc then removeGlowFromModel(npc) end
		end
	end
end

Players.PlayerAdded:Connect(function(plr)
	if plr == LocalPlayer then return end
	plr.CharacterAdded:Connect(function(char) if playerGlowEnabled then applyGlowToModel(char) end end)
	if playerGlowEnabled and plr.Character then applyGlowToModel(plr.Character) end
end)
Players.PlayerRemoving:Connect(function(plr) if plr.Character then removeGlowFromModel(plr.Character) end end)
Workspace.DescendantAdded:Connect(function(desc) if isNPC(desc) and npcGlowEnabled then applyGlowToModel(desc) end end)
Workspace.DescendantRemoving:Connect(function(desc) if activeHighlights[desc] then removeGlowFromModel(desc) end end)

-- ====================== FOOTSTEPS ======================
local function clearAllFootsteps()
	for _, fs in ipairs(activeFootsteps) do fs.drawing:Remove() end
	activeFootsteps = {}
end

local function addFootstep(position)
	local circle = Drawing.new("Circle")
	circle.Position = Camera:WorldToViewportPoint(position)
	circle.Radius = footstepSize
	circle.Color = FOOTSTEP_COLOR
	circle.Thickness = 1
	circle.Filled = true
	circle.Transparency = 0.8
	circle.Visible = true
	table.insert(activeFootsteps, {drawing = circle, expiry = os.clock() + footstepDuration, worldPos = position})
end

local footstepTimer = 0
RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	for i = #activeFootsteps, 1, -1 do
		local fs = activeFootsteps[i]
		if now >= fs.expiry then
			fs.drawing:Remove()
			table.remove(activeFootsteps, i)
		else
			local screenPos = Camera:WorldToViewportPoint(fs.worldPos)
			fs.drawing.Position = Vector2.new(screenPos.X, screenPos.Y)
			fs.drawing.Visible = screenPos.Z > 0
		end
	end
	if not footstepsEnabled then return end
	footstepTimer = footstepTimer + dt
	if footstepTimer >= footstepInterval then
		footstepTimer = 0
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr == LocalPlayer then continue end
			local char = plr.Character
			if char then
				local root = char:FindFirstChild("HumanoidRootPart")
				if root then addFootstep(root.Position) end
			end
		end
		for _, npc in ipairs(activeNPCs) do
			if npc and npc.Parent then
				local root = npc:FindFirstChild("HumanoidRootPart")
				if root then addFootstep(root.Position) end
			end
		end
	end
end)

