local function addSlider(name, minVal, maxVal, defaultVal, decimals, callback)
	local container = Instance.new("Frame", scrollFrame)
	container.Size = UDim2.new(1, -12, 0, 40)
	container.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	container.BackgroundTransparency = 0.6
	container.BorderSizePixel = 0
	Instance.new("UICorner", container).CornerRadius = UDim.new(0, 4)
	container.LayoutOrder = #scrollFrame:GetChildren() + 1

	local label = Instance.new("TextLabel", container)
	label.Size = UDim2.new(0, 160, 0, 16)
	label.Position = UDim2.new(0, 8, 0, 2)
	label.BackgroundTransparency = 1
	label.Text = name .. ": " .. (decimals and string.format("%."..decimals.."f", defaultVal) or math.floor(defaultVal))
	label.TextColor3 = Color3.fromRGB(240, 240, 240)
	label.Font = Enum.Font.Gotham
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left

	local sliderBar = Instance.new("Frame", container)
	sliderBar.Size = UDim2.new(1, -20, 0, 4)
	sliderBar.Position = UDim2.new(0, 10, 0, 24)
	sliderBar.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
	sliderBar.BorderSizePixel = 0
	Instance.new("UICorner", sliderBar).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame", sliderBar)
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(100, 140, 255)
	fill.BorderSizePixel = 0
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("TextButton", sliderBar)
	knob.Size = UDim2.new(0, 12, 0, 12)
	knob.Position = UDim2.new(0, 0, 0.5, -6)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.Text = ""
	knob.BorderSizePixel = 0
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local currentValue = defaultVal
	local draggingSlider = false

	local function setValue(value)
		value = math.clamp(value, minVal, maxVal)
		currentValue = value
		local fraction = (value - minVal) / (maxVal - minVal)
		fill.Size = UDim2.new(fraction, 0, 1, 0)
		knob.Position = UDim2.new(fraction, -6, 0.5, -6)
		local display = decimals and string.format("%."..decimals.."f", value) or math.floor(value)
		label.Text = name .. ": " .. display
		callback(value)
	end

	knob.MouseButton1Down:Connect(function() draggingSlider = true end)
	UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end end)
	sliderBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			draggingSlider = true
			local mousePos = UserInputService:GetMouseLocation()
			local barAbsolutePos = sliderBar.AbsolutePosition
			local barSizeX = sliderBar.AbsoluteSize.X
			local relativeX = (mousePos.X - barAbsolutePos.X) / barSizeX
			local newValue = minVal + relativeX * (maxVal - minVal)
			setValue(newValue)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
			local barAbsolutePos = sliderBar.AbsolutePosition
			local barSizeX = sliderBar.AbsoluteSize.X
			local relativeX = (input.Position.X - barAbsolutePos.X) / barSizeX
			local newValue = minVal + relativeX * (maxVal - minVal)
			setValue(newValue)
		end
	end)

	setValue(defaultVal)
	return { Set = setValue, Get = function() return currentValue end }
end

