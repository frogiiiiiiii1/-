-- Пульсирующие круги
local function createPulseCircle(size, pos, color, delay)
    local Circle = Instance.new("Frame")
    Circle.Parent = AnimFrame
    Circle.AnchorPoint = Vector2.new(0.5, 0.5)
    Circle.Position = pos
    Circle.Size = UDim2.new(0, 0, 0, 0)
    Circle.BackgroundColor3 = color
    Circle.BackgroundTransparency = 0.6
    Circle.BorderSizePixel = 0
    Circle.ZIndex = 1

    local CircleCorner = Instance.new("UICorner")
    CircleCorner.CornerRadius = UDim.new(1, 0)
    CircleCorner.Parent = Circle

    task.spawn(function()
        task.wait(delay)
        while Circle.Parent do
            Circle.Size = UDim2.new(0, 0, 0, 0)
            Circle.BackgroundTransparency = 0.6
            local tweenIn = game:GetService("TweenService"):Create(
                Circle,
                TweenInfo.new(3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {Size = UDim2.new(0, size, 0, size), BackgroundTransparency = 0.95}
            )
            tweenIn:Play()
            tweenIn.Completed:Wait()
            task.wait(0.3)
        end
    end)
end

