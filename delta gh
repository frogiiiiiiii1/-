    if not S.bossInfo.enabled or not S.bossInfo.frame then return end
    local aiZones = workspace:FindFirstChild("AiZones")
    if not aiZones then return end
    local locs = { Anton   = { zone = "Sawmill",  name = "Anton" },
        Dozer   = { zone = "Factory",  name = "Dozer" },
        Whisper = { zone = "Whisper",  name = "Whisper" },
        Death   = { zone = "Death",    name = "Death" } }
    for key, info in pairs(locs) do
        local lbl = S.bossInfo.labels[key]
        if lbl then
            local zone = aiZones:FindFirstChild(info.zone)
            local boss = zone and zone:FindFirstChild(info.name)
            local hum = boss and boss:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                lbl.Text = info.name .. ": " .. math.floor(hum.Health) .. " HP"
                lbl.TextColor3 = Color3.fromRGB(60, 255, 60)
            else
                lbl.Text = info.name .. ": Dead"
                lbl.TextColor3 = Color3.fromRGB(255, 60, 60)
            end
        end
    end
end
