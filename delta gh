            F.misc.visorOriginals.mask = mask and mask.Visible or false
            F.misc.visorOriginals.helmet = helm and helm.Visible or false
            F.misc.visorOriginals.flash = fb and fb.Visible or false
        end
        if visor then visor.Visible = false end
        if mask then mask.Visible = false end
        if helm then helm.Visible = false end
        if fb then fb.Visible = false end
    else
        if visor and F.misc.visorOriginals.visor ~= nil then visor.Visible = F.misc.visorOriginals.visor end
        if mask and F.misc.visorOriginals.mask ~= nil then mask.Visible = F.misc.visorOriginals.mask end
