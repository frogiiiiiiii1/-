        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local rip = Instance.new("Frame")
        rip.AnchorPoint = Vector2.new(0.5,0.5)
        rip.Size = UDim2.fromOffset(0,0)
        rip.Position = UDim2.fromOffset(
            input.Position.X - card.AbsolutePosition.X,
            input.Position.Y - card.AbsolutePosition.Y)
        rip.BackgroundColor3 = THEME.AccentGlow
        rip.BackgroundTransparency = 0.7
        rip.BorderSizePixel = 0
        rip.ZIndex = 30
        rip.Parent = card
