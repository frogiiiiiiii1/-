local function updateConstellation(dt)
    local vp = workspace.CurrentCamera.ViewportSize
    for i, n in ipairs(UI.nodes) do
        n.x = n.x + n.vx * dt
        n.y = n.y + n.vy * dt
        n.pulse = n.pulse + dt*2
        if n.x < 0 then n.x = vp.X elseif n.x > vp.X then n.x = 0 end
        if n.y < 0 then n.y = vp.Y elseif n.y > vp.Y then n.y = 0 end
        local dot = UI.nodeDots[i]
        if dot then
            dot.Position = UDim2.fromOffset(n.x, n.y)
            local p = 0.5 + math.sin(n.pulse)*0.5
            dot.BackgroundTransparency = 0.55 - p*0.35
            dot.Size = UDim2.fromOffset(5+p*3, 5+p*3)
        end
    end
    for i=1,#UI.nodes do
        for j=i+1,#UI.nodes do
            local line = UI.nodeLines[i] and UI.nodeLines[i][j]
            local a, b = UI.nodes[i], UI.nodes[j]
            if line and a and b then
                local dx, dy = b.x-a.x, b.y-a.y
                local dist = math.sqrt(dx*dx + dy*dy)
                if dist < 220 and dist > 1 then
                    local t = 1 - (dist/220)
                    line.Position = UDim2.fromOffset((a.x+b.x)/2, (a.y+b.y)/2)
                    line.Size = UDim2.fromOffset(dist, 1)
                    line.Rotation = math.deg(math.atan2(dy, dx))
                    line.BackgroundTransparency = 1 - t*0.75
                else line.BackgroundTransparency = 1 end
            end
        end
    end
end

local function updateFlies(dt)
    local vp = workspace.CurrentCamera.ViewportSize
    for _, f in ipairs(UI.flies) do
        if f.obj.Parent then
            f.wander = f.wander + dt*1.5
            f.vx = math.clamp(f.vx + math.cos(f.wander)*15*dt, -55, 55)
            f.vy = math.clamp(f.vy + math.sin(f.wander)*15*dt, -55, 55)
            f.x = f.x + f.vx*dt; f.y = f.y + f.vy*dt
            f.t = f.t + dt
            if f.x < -20 then f.x = vp.X+20 elseif f.x > vp.X+20 then f.x = -20 end
            if f.y < -20 then f.y = vp.Y+20 elseif f.y > vp.Y+20 then f.y = -20 end
            if f.t > f.life then
                f.x = math.random()*vp.X; f.y = math.random()*vp.Y
                f.vx = (math.random()-0.5)*45; f.vy = (math.random()-0.5)*45
                f.t = 0; f.life = 6 + math.random()*6
            end
            local fade = math.sin((f.t/f.life)*math.pi)
            f.obj.Position = UDim2.fromOffset(f.x, f.y)
            f.obj.BackgroundTransparency = 0.15 + (1-fade)*0.75
            f.halo.ImageTransparency = 0.55 + (1-fade)*0.4
            f.halo.Size = UDim2.fromOffset(40 + fade*20, 40 + fade*20)
        end
    end
end

UI.animConn = RunService.RenderStepped:Connect(function(dt)
    local t = UI.bgT
    if UI.coreGlow.Parent then
        UI.coreGlow.ImageTransparency = 0.86 + math.sin(t*1.4)*0.06
        UI.ringOuter.Rotation = (t*20) % 360
        UI.ringInner.Rotation = (-t*35) % 360
        for _, d in ipairs(UI.dots) do
            if d.obj.Parent then
                local wave = math.sin(t*1.2 + (d.baseX+d.baseY)*0.25 + d.phase)
                d.obj.BackgroundTransparency = 0.88 + wave*0.06
                d.obj.BackgroundColor3 = (wave>0.5) and THEME.AccentGlow or THEME.Accent
            end
        end
        local vp = workspace.CurrentCamera.ViewportSize
        for _, p in ipairs(UI.particles) do
            if p.obj.Parent then
                p.x = p.x + p.vx*dt; p.y = p.y + p.vy*dt
                p.life = p.life + dt
                if p.life > p.maxLife or p.y < -20 then
                    p.x = math.random()*vp.X; p.y = vp.Y+20
                    p.vx = (math.random()-0.5)*12
                    p.vy = -6 - math.random()*14
                    p.life = 0; p.maxLife = 4 + math.random()*4
                end
                local a = p.life/p.maxLife
                p.obj.Position = UDim2.fromOffset(p.x, p.y)
                p.obj.BackgroundTransparency = math.clamp(1 - math.sin(a*math.pi)*0.7, 0.1, 1)
            end
        end
        local scanY = ((t*220) % (vp.Y + 160)) - 80
        UI.scanline.Position = UDim2.new(0,0,0, scanY)
        UI.segGlow.ImageTransparency = 0.86 + math.sin(t*2.5)*0.06
