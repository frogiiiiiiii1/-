local function keyName(k)
    if not k then return "None" end
    return tostring(k):gsub("Enum.KeyCode.", "")
end
local function mouseName(m)
    if not m then return "None" end
    return tostring(m):gsub("Enum.UserInputType%.", "")
end
local function bindDisplay(bt, k, m)
    if bt == "Mouse" then return mouseName(m) end
    return keyName(k)
end
local function cardHeight()
    return UI.menuApp.compactMode and 32 or 40
end

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        local vp = workspace.CurrentCamera.ViewportSize
