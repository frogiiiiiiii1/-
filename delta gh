--============================================================
-- CONFIG SYSTEM
--============================================================
local function cfgRead()
    local out = {}
    if not isfile or not readfile then return out end
    local ok, txt = pcall(function()
        if isfile(F.cfg.INDEX) then return readfile(F.cfg.INDEX) end
    end)
    if not ok or not txt then return out end
    for line in txt:gmatch("[^\r\n]+") do
        local n = line:match("^%s*(.-)%s*$")
        if n ~= "" then table.insert(out, n) end
    end
    return out
end
local function cfgWrite(names)
    if not writefile then return end
    pcall(function() writefile(F.cfg.INDEX, table.concat(names, "\n")) end)
end
local function cfgAdd(n)
    local a = cfgRead()
    for _, x in ipairs(a) do if x == n then return end end
    table.insert(a, n); table.sort(a); cfgWrite(a)
end
local function cfgRem(n)
    local a = cfgRead()
    local o = {}
    for _, x in ipairs(a) do if x ~= n then table.insert(o, x) end end
    cfgWrite(o)
end
local function cfgList()
    local names, seen = {}, {}
    for _, n in ipairs(cfgRead()) do
        if not seen[n] then seen[n] = true; table.insert(names, n) end
    end
    local ok, files = pcall(function() if listfiles then return listfiles() end end)
    if ok and files then
        for _, p in ipairs(files) do
            local pp = tostring(p):gsub("\\", "/")
            local fn = pp:match("([^/]+)$") or pp
            if fn:sub(1, #F.cfg.PREFIX) == F.cfg.PREFIX and fn:sub(-4) == ".txt" then
                local cn = fn:sub(#F.cfg.PREFIX + 1, -5)
                if cn ~= "" and not seen[cn] then
                    seen[cn] = true; table.insert(names, cn)
                end
            end
        end
    end
    table.sort(names)
    return names
end
local function cfgDel(n)
    if not delfile then return false end
    local ok = pcall(delfile, F.cfg.PREFIX .. n .. ".txt")
    if ok then cfgRem(n) end
    return ok
end

local function keyFromName(name)
    if not name or name == "" then return nil end
    local ok, k = pcall(function() return Enum.KeyCode[name] end)
    if ok and k then return k end
    return nil
end
local function mouseFromName(name)
    if not name or name == "" then return nil end
    local ok, k = pcall(function() return Enum.UserInputType[name] end)
    if ok and k then return k end
    return nil
end

