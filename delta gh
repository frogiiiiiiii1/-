local LANDMINE_NAMES = { PMN2 = true, MON50 = true }
local function clearLandmines(container)
    if not container then return end
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("Model") and LANDMINE_NAMES[child.Name] then child:Destroy() end
    end
    if not S.landmines.conns[container] then
        S.landmines.conns[container] = container.ChildAdded:Connect(function(child)
            if S.landmines.enabled and child:IsA("Model") and LANDMINE_NAMES[child.Name] then
                task.wait(2.5)
                if child and child.Parent then child:Destroy() end
            end
        end)
    end
end

local function applyNoLandmines(state)
    S.landmines.enabled = state
    local aiZones = workspace:FindFirstChild("AiZones")
    if not aiZones then return end
    if state then
        if aiZones:FindFirstChild("Landmines") then
            clearLandmines(aiZones.Landmines)
            clearLandmines(aiZones:FindFirstChild("Claymores"))
        else
            clearLandmines(aiZones:FindFirstChild("OutpostLandmines"))
            clearLandmines(aiZones:FindFirstChild("BridgeClaymores"))
            clearLandmines(aiZones:FindFirstChild("HeliCrashClaymores"))
