            S.landmines.zoneConns[aiZones] = aiZones.ChildAdded:Connect(function(child)
                if S.landmines.enabled and (child.Name == "Landmines" or child.Name == "Claymores"
                    or child.Name:find("Landmines") or child.Name:find("Claymores")) then
                    task.wait(0.3); clearLandmines(child)
