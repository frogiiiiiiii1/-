local function tryInstantEquip(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChild("Animator")
    if not animator then return end
    task.spawn(function()
        while S.new.instantEquip and char.Parent do
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                local anim = track.Animation
                if anim and anim.Name == "Equip" then
                    track:AdjustSpeed(15)
                    track.TimePosition = track.Length - 0.01
                end
            end
            task.wait(0.001)
        end
    end)
end

local function findScreenEffects()
    local gui = LocalPlayer.PlayerGui:FindFirstChild("NoInsetGui")
    if not gui then return nil end
    local mf = gui:FindFirstChild("MainFrame")
    if not mf then return nil end
    return mf:FindFirstChild("ScreenEffects")
end

local function processVisor()
    local se = findScreenEffects()
    if not se then return end
    local visor = se:FindFirstChild("Visor")
    local mask = se:FindFirstChild("Mask")
    local helmetMask = se:FindFirstChild("HelmetMask")
    local flashbang = se:FindFirstChild("Flashbang")
    if S.new.noVisor then
        if not S.visorOriginals.saved then
            S.visorOriginals.saved = true
            S.visorOriginals.visor = visor and visor.Visible or false
            S.visorOriginals.mask = mask and mask.Visible or false
            S.visorOriginals.helmet = helmetMask and helmetMask.Visible or false
            S.visorOriginals.flash = flashbang and flashbang.Visible or false
        end
        if visor then visor.Visible = false end
        if mask then mask.Visible = false end
        if helmetMask then helmetMask.Visible = false end
        if flashbang then flashbang.Visible = false end
    else
        if visor and S.visorOriginals.visor ~= nil then visor.Visible = S.visorOriginals.visor end
        if mask and S.visorOriginals.mask ~= nil then mask.Visible = S.visorOriginals.mask end
        if helmetMask and S.visorOriginals.helmet ~= nil then helmetMask.Visible = S.visorOriginals.helmet end
        if flashbang and S.visorOriginals.flash ~= nil then flashbang.Visible = S.visorOriginals.flash end
    end
end

local function applyNoVisor(enable)
    S.new.noVisor = enable
    if enable then
        processVisor()
        if not S.visorWatch then S.visorWatch = RunService.Heartbeat:Connect(processVisor) end
    else
        if S.visorWatch then S.visorWatch:Disconnect(); S.visorWatch = nil end
        processVisor()
    end
end

local function applyGasMaskSound(enable)
