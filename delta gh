task.spawn(function()
    pcall(function()
        local Loading = UI.Loading
        Loading.BackgroundTransparency = 1
        TweenService:Create(Loading, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {BackgroundTransparency=0}):Play()
        task.wait(0.2)

        UI.ringOuter.Size = UDim2.fromOffset(0,0)
        UI.ringInner.Size = UDim2.fromOffset(0,0)
        TweenService:Create(UI.ringOuter, TweenInfo.new(0.9, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Size=UDim2.new(0,460,0,460)}):Play()
        TweenService:Create(UI.ringInner, TweenInfo.new(0.9, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Size=UDim2.new(0,360,0,360)}):Play()
        task.wait(0.35)

        for i, l in ipairs(UI.mainLetters) do
            local side = (i % 2 == 0) and 1 or -1
            l.Position = UDim2.fromOffset(60*side, 30)
            l.Rotation = 12*side
            TweenService:Create(l, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                {TextTransparency=0, Position=UDim2.fromOffset(0,0), Rotation=0}):Play()
            TweenService:Create(UI.magentaLetters[i], TweenInfo.new(0.35), {TextTransparency=0.55}):Play()
            TweenService:Create(UI.cyanLetters[i], TweenInfo.new(0.35), {TextTransparency=0.55}):Play()
            task.wait(0.075)
        end

        task.wait(0.15)
        for i = 1, #UI.mainLetters do
            TweenService:Create(UI.magentaLetters[i], TweenInfo.new(0.55), {TextTransparency=1}):Play()
            TweenService:Create(UI.cyanLetters[i], TweenInfo.new(0.55), {TextTransparency=1}):Play()
        end

        TweenService:Create(UI.underline, TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {Size=UDim2.new(0,380,0,2)}):Play()
        TweenService:Create(UI.statusLbl, TweenInfo.new(0.3), {TextTransparency=0}):Play()
        TweenService:Create(UI.percentLbl, TweenInfo.new(0.3), {TextTransparency=0}):Play()
        TweenService:Create(UI.cornerTag, TweenInfo.new(0.3), {TextTransparency=0}):Play()
        TweenService:Create(UI.rightTag, TweenInfo.new(0.3), {TextTransparency=0}):Play()
        TweenService:Create(UI.topBar, TweenInfo.new(0.4), {BackgroundTransparency=0.55}):Play()
        TweenService:Create(UI.bottomBar, TweenInfo.new(0.4), {BackgroundTransparency=0.55}):Play()
        task.wait(0.15)

        local steps = {
            {pct=14, text="bootstrapping runtime", delay=0.32},
            {pct=28, text="loading libraries", delay=0.36},
            {pct=42, text="mounting ui layer", delay=0.32},
            {pct=57, text="installing hooks", delay=0.36},
            {pct=71, text="spawning threads", delay=0.34},
            {pct=85, text="warming cache", delay=0.36},
            {pct=94, text="finalizing", delay=0.34},
            {pct=100, text="ready", delay=0.45},
        }
        local filled = 0
        for _, step in ipairs(steps) do
            local target = math.floor(UI.SEG_COUNT * (step.pct/100) + 0.5)
            for i = filled+1, target do
                if UI.segments[i] then
                    UI.segments[i].BackgroundColor3 = THEME.Accent
                    TweenService:Create(UI.segments[i], TweenInfo.new(0.12),
                        {BackgroundTransparency=0}):Play()
                end
                task.wait(0.012)
            end
            filled = target
            UI.percentLbl.Text = tostring(step.pct) .. "%"
            UI.rightTag.Text = step.text
            task.wait(step.delay)
        end

        task.wait(0.15)
        UI.flash.BackgroundTransparency = 0.55
        TweenService:Create(UI.flash, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {BackgroundTransparency=1}):Play()
        task.wait(0.3)

        for _, obj in ipairs(Loading:GetDescendants()) do
            if obj:IsA("TextLabel") then
                TweenService:Create(obj, TweenInfo.new(0.5), {TextTransparency=1}):Play()
            elseif obj:IsA("ImageLabel") then
                TweenService:Create(obj, TweenInfo.new(0.5), {ImageTransparency=1}):Play()
            elseif obj:IsA("Frame") then
                TweenService:Create(obj, TweenInfo.new(0.5), {BackgroundTransparency=1}):Play()
            end
        end
        TweenService:Create(Loading, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {BackgroundTransparency=1}):Play()
        task.wait(0.6)

        Loading:Destroy()
        UI.animConn:Disconnect()

        animateMenuOpen(true)
        task.wait(0.6)
        setStatus("GootHub loaded · RShift to toggle")
    end)
end)

