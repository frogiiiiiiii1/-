local function rebuildESP()
    if anyFlagOn() then
        if not S.espActive then
            S.espActive = true
            for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
        end
    elseif S.espActive then
        S.espActive = false
        for p in pairs(S.espData) do removeESP(p) end
    end
end

local function screenPosOf(camera, part)
    if not part then return nil end
    local p, onScreen = camera:WorldToViewportPoint(part.Position)
    if not onScreen or p.Z <= 0 then return nil end
    return Vector2.new(p.X, p.Y)
end

local function drawLine(frame, a, b)
    local delta = b - a
    local length = delta.Magnitude
    if length < 1 then frame.Visible = false; return end
    local center = (a + b) * 0.5
    frame.Position = UDim2.fromOffset(center.X, center.Y)
    frame.Size = UDim2.fromOffset(length, 1)
    frame.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    frame.Visible = true
end

local function clampArrowToEdge(camera, worldPos)
    local vp = camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local p, onScreen = camera:WorldToViewportPoint(worldPos)
    if onScreen and p.Z > 0 then return nil end
    local p2 = Vector2.new(p.X, p.Y)
    if p.Z <= 0 then p2 = center - (p2 - center) end
    local dir = p2 - center
    if dir.Magnitude < 1 then dir = Vector2.new(0, -1) end
    dir = dir.Unit
    local margin = 40
    local half = Vector2.new(vp.X / 2 - margin, vp.Y / 2 - margin)
    local scale = math.min(half.X / math.max(math.abs(dir.X), 1e-4),
        half.Y / math.max(math.abs(dir.Y), 1e-4))
    return center + dir * scale, dir
end

local function updateESP()
    if not S.espActive then return end
    local Camera = workspace.CurrentCamera
    if not Camera then return end
    local camPos = Camera.CFrame.Position
    for player, d in pairs(S.espData) do
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if S.espFlags.skeleton and char then
            local bones = char:FindFirstChild("UpperTorso") and ESPC.R15 or ESPC.R6
            for i, line in ipairs(d.lines) do
                local pair = bones[i]
                if pair then
                    local pA = char:FindFirstChild(pair[1])
                    local pB = char:FindFirstChild(pair[2])
                    local sA = pA and screenPosOf(Camera, pA)
                    local sB = pB and screenPosOf(Camera, pB)
                    if sA and sB then
                        drawLine(line, sA, sB)
                        line.BackgroundColor3 = S.espColors.skeleton
                    else line.Visible = false end
                else line.Visible = false end
            end
        else
            for _, line in ipairs(d.lines) do line.Visible = false end
        end
        if S.espFlags.arrow and hrp then
            local edge, dir = clampArrowToEdge(Camera, hrp.Position)
            if edge and dir then
                d.arrow.Position = UDim2.fromOffset(edge.X, edge.Y)
                d.arrow.Rotation = math.deg(math.atan2(dir.Y, dir.X))
                d.arrow.TextColor3 = S.espColors.arrow
                d.arrow.Visible = true
            else d.arrow.Visible = false end
        else d.arrow.Visible = false end
        if not (hrp and hum) then
            d.box.Visible = false; d.nameLabel.Visible = false; d.weaponLabel.Visible = false
            d.hpBg.Visible = false; d.tracer.Visible = false; d.headDot.Visible = false
            continue
        end
        local topWorld = head and (head.Position + Vector3.new(0, 0.7, 0))
            or (hrp.Position + Vector3.new(0, 3, 0))
        local botWorld = hrp.Position - Vector3.new(0, 2.6, 0)
        local topPos, topOn = Camera:WorldToViewportPoint(topWorld)
        local botPos, botOn = Camera:WorldToViewportPoint(botWorld)
        local onScreen = topOn and botOn and topPos.Z > 0 and botPos.Z > 0
        if not onScreen then
            d.box.Visible = false; d.nameLabel.Visible = false; d.weaponLabel.Visible = false
            d.hpBg.Visible = false; d.tracer.Visible = false; d.headDot.Visible = false
        else
            local h = math.abs(botPos.Y - topPos.Y)
            local w = h * 0.55
            local x = topPos.X - w / 2
            local y = topPos.Y
            if S.espFlags.box or S.espFlags.filledBox then
                d.box.Position = UDim2.fromOffset(x, y)
                d.box.Size = UDim2.fromOffset(w, h)
                d.box.Visible = true
                d.box.BackgroundColor3 = S.espColors.box
                d.box.BackgroundTransparency = S.espFlags.filledBox and 0.75 or 1
                d.stroke.Color = S.espColors.box
                d.stroke.Transparency = S.espFlags.box and 0.1 or 1
            else d.box.Visible = false end
            if S.espFlags.name or S.espFlags.distance then
                local parts = {}
                if S.espFlags.name then
                    local nameText = player.Name
                    if S.cheaterDet.cheaters[player.Name] then
                        nameText = nameText .. " | Cheater"
                        d.nameLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
                    elseif S.modDet.moderators[player.Name] then
                        nameText = nameText .. " | Moderator"
                        d.nameLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
                    else d.nameLabel.TextColor3 = S.espColors.name end
                    table.insert(parts, nameText)
                end
                if S.espFlags.distance then
                    local dist = (camPos - hrp.Position).Magnitude
                    table.insert(parts, string.format("[%dm]", math.floor(dist)))
                end
                d.nameLabel.Text = table.concat(parts, "  ")
                d.nameLabel.Size = UDim2.fromOffset(math.max(w * 1.8, 150), 18)
                d.nameLabel.Position = UDim2.fromOffset(x + w / 2, y - 3)
                d.nameLabel.Visible = true
            else d.nameLabel.Visible = false end
            if S.espFlags.weapon then
                local weapon = getActiveWeapon(player)
                if weapon and weapon ~= "None" and weapon ~= "" then
                    d.weaponLabel.Text = "🔫 " .. weapon
                    d.weaponLabel.TextColor3 = S.espColors.weapon
                    d.weaponLabel.Size = UDim2.fromOffset(math.max(w * 2, 160), 16)
                    d.weaponLabel.Position = UDim2.fromOffset(x + w / 2, y + h + 3)
                    d.weaponLabel.Visible = true
                else d.weaponLabel.Visible = false end
            else d.weaponLabel.Visible = false end
            if S.espFlags.health then
                local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                d.hpBg.Position = UDim2.fromOffset(x - 7, y)
                d.hpBg.Size = UDim2.fromOffset(4, h)
                d.hpBg.Visible = true
                d.hpBar.Position = UDim2.new(0, 0, pct, 0)
                d.hpBar.Size = UDim2.new(1, 0, pct, 0)
                d.hpBar.BackgroundColor3 = Color3.fromRGB(255 * (1 - pct), 255 * pct, 0)
            else d.hpBg.Visible = false end
            if S.espFlags.tracers then
                local origin = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                local target = Vector2.new(topPos.X, topPos.Y)
                drawLine(d.tracer, origin, target)
                d.tracer.BackgroundColor3 = S.espColors.tracers
            else d.tracer.Visible = false end
            if S.espFlags.headDot then
                d.headDot.Position = UDim2.fromOffset(topPos.X, topPos.Y - 6)
                d.headDot.BackgroundColor3 = S.espColors.headDot
                d.headDot.Visible = true
            else d.headDot.Visible = false end
        end
    end
end

