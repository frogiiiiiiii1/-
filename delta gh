local function isAnyMenuOpen()
    return Main and Main.Parent and Main.Visible
end

local function isInventoryOpen()
    local pg = LocalPlayer.PlayerGui
    local mainGui = pg:FindFirstChild("MainGui")
    if not mainGui then return false end
    local mf = mainGui:FindFirstChild("MainFrame")
    if not mf then return false end
    local backpack = mf:FindFirstChild("BackpackFrame")
    if backpack and backpack.Visible then return true end
    return false
end

