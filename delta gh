        end)
        UI.hudTime.Text = os.date("%H:%M:%S")
        UI.hudTimeDot.BackgroundColor3 = THEME.AccentGlow
    end

    local sweepP = (bgT % 2.5) / 2.5
    UI.wmSweep.Position = UDim2.new(-0.4 + sweepP*1.8, 0, 0, 0)
    local gp = 0.5 + math.sin(bgT*2.2)*0.5
    UI.wmRing1Stroke.Transparency = 0.7 - gp*0.4
    UI.wmRing2Stroke.Transparency = 0.85 - gp*0.3
    UI.wmGlyphCore.BackgroundColor3 = (gp > 0.5) and THEME.AccentGlow or THEME.Accent
    for i, bar in ipairs(UI.wmEqBars) do
        local wave = math.sin(UI.wmEqPhase*(1.8 + i*0.12) + bar.phase)
        bar.obj.Size = UDim2.new(0, 2, 0, 3 + (wave*0.5+0.5)*13)
    end
    local tSweep = (bgT*0.6) % 2
    UI.titleSweep.Position = UDim2.new(-0.3 + tSweep*1.5, 0, 1, -1)
    local sp = 0.5 + math.sin(bgT*2.6)*0.5
    UI.sbPulse.BackgroundColor3 = (sp > 0.5) and THEME.AccentGlow or THEME.Accent
    UI.sbPulse.BackgroundTransparency = 0.3 - sp*0.2
    local lp = 0.5 + math.sin(bgT*1.8)*0.5
    UI.lr1s.Transparency = 0.7 - lp*0.4
    UI.lr2s.Transparency = 0.85 - lp*0.3

    if UI.Backdrop.Visible then
        local vp = workspace.CurrentCamera.ViewportSize
        for _, band in ipairs(UI.auroraBands) do
            local cfg = band.cfg
            local offset = math.sin(bgT*cfg.speed + band.phase)*cfg.amp
            local y = (cfg.yBase + offset)*vp.Y
            band.obj.Position = UDim2.fromOffset(0, y - cfg.thick/2)
            band.obj.ImageTransparency = cfg.trans + math.sin(bgT*cfg.speed*1.7)*0.04
        end
        for _, layer in ipairs(UI.starLayers) do
            for _, s in ipairs(layer.stars) do
                if s.obj.Parent then
                    s.tw = s.tw + dt*s.twSpeed
                    s.y = s.y - layer.cfg.drift*dt*2
                    if s.y < -4 then s.y = vp.Y + 4 end
                    s.obj.Position = UDim2.fromOffset(s.x, s.y)
                    s.obj.BackgroundTransparency = s.baseTrans + math.sin(s.tw)*0.15
                end
            end
        end
        updateConstellation(dt)
        updateFlies(dt)
        UI.mouseGlowCurrent = UI.mouseGlowCurrent:Lerp(UI.mouseWorldPos, math.min(dt*8, 1))
        UI.mouseGlow.Position = UDim2.fromOffset(UI.mouseGlowCurrent.X, UI.mouseGlowCurrent.Y)
        UI.mouseGlow.ImageTransparency = 0.82 + math.sin(bgT*2)*0.05
