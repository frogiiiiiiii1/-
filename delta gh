local VM_MATS = { "Plastic","SmoothPlastic","Neon","Metal","Wood","WoodPlanks",
    "Marble","Slate","Concrete","Granite","Brick","Cobblestone","CorrodedMetal",
    "DiamondPlate","Foil","Fabric","Ice","Glass","ForceField" }
local VM_MOT = { "Motor6D","LeftUpperArm","RightUpperArm" }
local VM_ARM = { LeftHand=true, LeftLowerArm=true, LeftUpperArm=true,
    RightHand=true, RightLowerArm=true, RightUpperArm=true }
local VM_SKIP = { HumanoidRootPart=true, AimPart=true, AimPartCanted=true, FakeCamera=true }

local function vmMat(n)
    local ok, m = pcall(function() return Enum.Material[n] end)
    return (ok and m) or Enum.Material.Plastic
end
local function vmIsArm(n) return VM_ARM[n] == true end
local function vmIsW(n) return not VM_ARM[n] and not VM_SKIP[n] end

local function vmMotors(vm)
    local hrp = vm:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end
    local o = {}
    for _, n in ipairs(VM_MOT) do
        local m = hrp:FindFirstChild(n)
        if m and m:IsA("Motor6D") then table.insert(o, m) end
    end
    if #o == 0 then
        for _, n in ipairs(VM_MOT) do
            local m = vm:FindFirstChild(n)
            if m and m:IsA("Motor6D") then table.insert(o, m) end
        end
    end
    return o
end

local function vmCapture(vm)
    F.vm.motorOriginals = {}
    F.vm.partOriginals = {}
    for _, m in ipairs(vmMotors(vm)) do F.vm.motorOriginals[m] = m.C0 end
    for _, d in ipairs(vm:GetDescendants()) do
        if d:IsA("BasePart") then
            if vmIsW(d.Name) then
                local sa = d:FindFirstChildOfClass("SurfaceAppearance")
                if sa then sa:Destroy() end
            end
            F.vm.partOriginals[d] = { Color=d.Color, Material=d.Material, Transparency=d.Transparency }
        end
    end
end

local function vmHook(vm)
    F.vm.currentVM = vm
    vmCapture(vm)
    if F.vm.vmConn then F.vm.vmConn:Disconnect(); F.vm.vmConn = nil end
    F.vm.vmConn = vm.DescendantAdded:Connect(function(d)
        if d:IsA("Motor6D") then
            for _, n in ipairs(VM_MOT) do
                if d.Name == n and not F.vm.motorOriginals[d] then
                    F.vm.motorOriginals[d] = d.C0
                end
            end
        elseif d:IsA("BasePart") and not F.vm.partOriginals[d] then
            F.vm.partOriginals[d] = { Color=d.Color, Material=d.Material, Transparency=d.Transparency }
        end
    end)
end

task.spawn(function()
    local cam, t = nil, 0
    repeat cam = workspace.CurrentCamera; task.wait(0.1); t = t + 0.1
    until (cam and cam.Parent) or t > 15
    if not cam then return end
    local vm = cam:FindFirstChild("ViewModel")
    if vm then vmHook(vm) end
    cam.DescendantAdded:Connect(function(d)
