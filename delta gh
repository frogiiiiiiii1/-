--============================================================
-- TAB SYSTEM
--============================================================
local Tabs = {}
local tabButtons = {}
local currentTabName = nil
local currentSubName = nil

local function setTabActive(tabName)
    for name, btn in pairs(tabButtons) do
        if name == tabName then
            TweenService:Create(btn, TweenInfo.new(0.18), { BackgroundColor3 = THEME.Accent }):Play()
            btn.TextColor3 = THEME.TextOn
        else
            TweenService:Create(btn, TweenInfo.new(0.18), { BackgroundColor3 = THEME.BgCard }):Play()
            btn.TextColor3 = THEME.TextDim
        end
    end
end

local function setSubActive(subName)
    local tab = Tabs[currentTabName]
    if not tab then return end
    for name, sub in pairs(tab.subs) do
        local btn = sub.button
        local cont = sub.container
        if btn and cont then
            if name == subName then
                cont.Visible = true
                TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = THEME.Accent }):Play()
                btn.TextColor3 = THEME.TextOn
            else
                cont.Visible = false
                TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = THEME.BgCard }):Play()
                btn.TextColor3 = THEME.TextDim
            end
        end
    end
end

local itemQueue = {}
local function queueItem(tabName, subName, fn)
    itemQueue[tabName] = itemQueue[tabName] or {}
    itemQueue[tabName][subName] = itemQueue[tabName][subName] or {}
    table.insert(itemQueue[tabName][subName], fn)
end

local function materializeSub(tabName, subName)
    local tab = Tabs[tabName]
    if not tab then return end
    local sub = tab.subs[subName]
    if not sub or sub.built then return end
    sub.built = true

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(90, 24)
    btn.BackgroundColor3 = THEME.BgCard
    btn.BorderSizePixel = 0
    btn.Text = subName
    btn.TextColor3 = THEME.TextDim
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 11
    btn.AutoButtonColor = false
    btn.LayoutOrder = sub.order
    btn.Visible = false
    btn.ZIndex = 13
    btn.Parent = SubBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    sub.button = btn

    local container = Instance.new("ScrollingFrame")
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.CanvasSize = UDim2.new(0, 0, 0, 0)
    container.AutomaticCanvasSize = Enum.AutomaticSize.Y
    container.ScrollBarThickness = 3
    container.ScrollBarImageColor3 = THEME.Accent
    container.ScrollBarImageTransparency = 0.5
    container.Visible = false
    container.ZIndex = 11
    container.Parent = PageScroll
    sub.container = container

    local list = Instance.new("UIListLayout", container)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Padding = UDim.new(0, 5)
    local cpad = Instance.new("UIPadding", container)
    cpad.PaddingTop = UDim.new(0, 2); cpad.PaddingBottom = UDim.new(0, 6)
    cpad.PaddingLeft = UDim.new(0, 2); cpad.PaddingRight = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        if currentTabName ~= tabName then return end
        currentSubName = subName
        setSubActive(subName)
    end)
    btn.MouseEnter:Connect(function()
        if currentSubName ~= subName then
            TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = THEME.BgCardHover }):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if currentSubName ~= subName then
            TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = THEME.BgCard }):Play()
        end
    end)

    local fns = itemQueue[tabName] and itemQueue[tabName][subName]
    if fns then
        for _, fn in ipairs(fns) do
            local ok, err = pcall(fn, container)
            if not ok then warn("[GootHub] build failed: " .. tostring(err)) end
        end
    end
end

local function materializeAllSubs()
    for tabName, tab in pairs(Tabs) do
        for subName, _ in pairs(tab.subs) do
            materializeSub(tabName, subName)
        end
    end
end

local function selectTab(tabName)
    if not Tabs[tabName] then return end
    currentTabName = tabName
    setTabActive(tabName)
    for otherName, otherTab in pairs(Tabs) do
        for _, sub in pairs(otherTab.subs) do
            if sub.button then sub.button.Visible = (otherName == tabName) end
            if sub.container then sub.container.Visible = false end
        end
    end
    local tab = Tabs[tabName]
    local ordered = {}
    for subName, subData in pairs(tab.subs) do
        table.insert(ordered, { name = subName, order = subData.order })
    end
    table.sort(ordered, function(a, b) return a.order < b.order end)
    local firstSub = nil
    for i, info in ipairs(ordered) do
        if i == 1 then firstSub = info.name end
    end
    if firstSub then
        currentSubName = firstSub
        setSubActive(firstSub)
    end
end

local tabOrder = 0
local function createTab(name)
    tabOrder = tabOrder + 1
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
