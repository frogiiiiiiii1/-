local function setTabActive(tabName)
    for name, btn in pairs(UI.tabButtons) do
        local isOn = (name == tabName)
        TweenService:Create(btn, TweenInfo.new(0.2),
            {BackgroundColor3 = isOn and THEME.BgCard or THEME.BgSidebar}):Play()
        btn.TextColor3 = isOn and THEME.TextOn or THEME.TextDim
        local prefix = btn:FindFirstChild("Prefix")
        local prefixGlow = btn:FindFirstChild("PrefixGlow")
        if prefix then
            TweenService:Create(prefix, TweenInfo.new(0.2),
                {BackgroundColor3 = isOn and THEME.AccentGlow or THEME.TextGhost}):Play()
        end
        if prefixGlow then prefixGlow.Visible = isOn end
    end
    local btn = UI.tabButtons[tabName]
    if btn then
        TweenService:Create(UI.indicator, TweenInfo.new(0.28, Enum.EasingStyle.Quart),
            {Position = UDim2.new(0,-1,0, btn.AbsolutePosition.Y - UI.Sidebar.AbsolutePosition.Y)}):Play()
        TweenService:Create(UI.indicator, TweenInfo.new(0.28),
            {Size = UDim2.new(0,3,0, btn.AbsoluteSize.Y)}):Play()
        TweenService:Create(UI.indicatorGlow, TweenInfo.new(0.28, Enum.EasingStyle.Quart),
            {Position = UDim2.new(0,-22,0, btn.AbsolutePosition.Y - UI.Sidebar.AbsolutePosition.Y - 6)}):Play()
        TweenService:Create(UI.indicatorGlow, TweenInfo.new(0.28),
            {Size = UDim2.new(0,60,0, btn.AbsoluteSize.Y + 12)}):Play()
    end
end

