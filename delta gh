local function gmCache(ammo)
    if F.gun.cached[ammo] then return end
    F.gun.cached[ammo] = {
        Recoil = ammo:GetAttribute("RecoilStrength"),
        Drop   = ammo:GetAttribute("ProjectileDrop"),
        Drag   = ammo:GetAttribute("Drag"),
    }
end

local function applyGunMods()
    local at = RServ:FindFirstChild("AmmoTypes")
    if not at then return end
    for _, ammo in ipairs(at:GetChildren()) do
        gmCache(ammo)
        local o = F.gun.cached[ammo]
        if F.gun.noRecoil then ammo:SetAttribute("RecoilStrength", 0)
        elseif o.Recoil ~= nil then ammo:SetAttribute("RecoilStrength", o.Recoil) end
        if F.gun.noDrop then ammo:SetAttribute("ProjectileDrop", 0)
        elseif o.Drop ~= nil then ammo:SetAttribute("ProjectileDrop", o.Drop) end
        if F.gun.noDrag then ammo:SetAttribute("Drag", 0)
        elseif o.Drag ~= nil then ammo:SetAttribute("Drag", o.Drag) end
    end
end

local function restoreGunMods()
    for ammo, o in pairs(F.gun.cached) do
        if ammo and ammo.Parent then
            if o.Recoil ~= nil then ammo:SetAttribute("RecoilStrength", o.Recoil) end
            if o.Drop ~= nil then ammo:SetAttribute("ProjectileDrop", o.Drop) end
            if o.Drag ~= nil then ammo:SetAttribute("Drag", o.Drag) end
        end
    end
end

