local function setFullbright(state)
    if state then
        if S.fbDef then return end
        S.fbDef = { A = Lighting.Ambient, O = Lighting.OutdoorAmbient,
            B = Lighting.Brightness, C = Lighting.ClockTime, S = Lighting.GlobalShadows, effects = {} }
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Atmosphere") or v:IsA("ColorCorrectionEffect")
                or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") then
                S.fbDef.effects[v] = v.Enabled; v.Enabled = false
            end
        end
    else
        if not S.fbDef then return end
        Lighting.Ambient = S.fbDef.A; Lighting.OutdoorAmbient = S.fbDef.O
        Lighting.Brightness = S.fbDef.B; Lighting.ClockTime = S.fbDef.C
        Lighting.GlobalShadows = S.fbDef.S
        for eff, was in pairs(S.fbDef.effects) do
            if eff and eff.Parent then eff.Enabled = was end
        end
        S.fbDef = nil
    end
end

