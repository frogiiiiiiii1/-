local function checkCheater(p)
    if p == LocalPlayer or not F.cheat.enabled then return end
    if F.cheat.cheaters[p.Name] then return end
    local plrs = RServ:FindFirstChild("Players")
    if not plrs then return end
    local pE = plrs:FindFirstChild(p.Name)
    local st = pE and pE:FindFirstChild("Status")
    local jr = st and st:FindFirstChild("Journey")
    local wipe = jr and jr:FindFirstChild("WipeStatistics")
    if not wipe then return end
    local deaths = wipe:GetAttribute("Deaths") or 0; if deaths == 0 then deaths = 1 end
    local kills = wipe:GetAttribute("Kills") or 0; if kills == 0 then kills = 1 end
    local kdr = math.floor(kills/deaths*10)/10
    local rl = RServ:FindFirstChild("ReportList")
    local rep = rl and (rl:FindFirstChild("MostWanted") or rl:FindFirstChild("Recent"))
    local flags, hsr, age = 0, 0, 999
    if rep then
        local r = rep:FindFirstChild(p.Name)
        if r then
            flags = r:GetAttribute("TotalFlags") or 0
            hsr = r:GetAttribute("HSR") or 0
            age = r:GetAttribute("Age") or 999
        end
    end
    if kills >= 15 and hsr >= 95 then
        F.cheat.cheaters[p.Name] = true
        notify("Cheater Detector", p.Name .. " | KDR: " .. kdr, 5)
    end
    if flags >= 75 and age <= 50 then
        F.cheat.cheaters[p.Name] = true
        notify("Cheater Detector", p.Name .. " | KDR: " .. kdr, 5)
    end
    if kills >= 15 and kdr >= 5 then
        F.cheat.cheaters[p.Name] = true
        notify("Cheater Detector", p.Name .. " | KDR: " .. kdr, 5)
    end
end

