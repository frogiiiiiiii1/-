        end
    end
    F.esp.data[player] = nil
end

local function rebuildESP()
    if anyEspFlag() then
        if not F.esp.active then
            F.esp.active = true
            for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
        end
    elseif F.esp.active then
        F.esp.active = false
        for p in pairs(F.esp.data) do removeESP(p) end
    end
end

local function screenPos(cam, part)
    if not part then return nil end
    local p, on = cam:WorldToViewportPoint(part.Position)
    if not on or p.Z <= 0 then return nil end
    return Vector2.new(p.X, p.Y)
end

local function drawLine(frame, a, b)
    local d = b - a
    local len = d.Magnitude
    if len < 1 then frame.Visible = false; return end
    local c = (a + b) * 0.5
    frame.Position = UDim2.fromOffset(c.X, c.Y)
    frame.Size = UDim2.fromOffset(len, 1)
    frame.Rotation = math.deg(math.atan2(d.Y, d.X))
    frame.Visible = true
end

local function clampArrow(cam, wp)
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)
    local p, on = cam:WorldToViewportPoint(wp)
    if on and p.Z > 0 then return nil end
    local p2 = Vector2.new(p.X, p.Y)
    if p.Z <= 0 then p2 = center - (p2 - center) end
    local dir = p2 - center
    if dir.Magnitude < 1 then dir = Vector2.new(0,-1) end
    dir = dir.Unit
    local margin = 40
    local half = Vector2.new(vp.X/2 - margin, vp.Y/2 - margin)
    local sc = math.min(half.X / math.max(math.abs(dir.X), 1e-4),
        half.Y / math.max(math.abs(dir.Y), 1e-4))
    return center + dir * sc, dir
end

local function updateESP()
    if not F.esp.active then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local camPos = cam.CFrame.Position
    for player, d in pairs(F.esp.data) do
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if F.esp.skeleton and char then
            local bones = char:FindFirstChild("UpperTorso") and F.esp.R15 or F.esp.R6
            for i, ln in ipairs(d.lines) do
                local pair = bones[i]
                if pair then
                    local pA = char:FindFirstChild(pair[1])
                    local pB = char:FindFirstChild(pair[2])
                    local sA = pA and screenPos(cam, pA)
                    local sB = pB and screenPos(cam, pB)
                    if sA and sB then
                        drawLine(ln, sA, sB)
                        ln.BackgroundColor3 = F.esp.colors.skeleton
                    else ln.Visible = false end
                else ln.Visible = false end
            end
        else
            for _, ln in ipairs(d.lines) do ln.Visible = false end
        end

        if F.esp.arrow and hrp then
            local edge, dir = clampArrow(cam, hrp.Position)
            if edge and dir then
                d.arrow.Position = UDim2.fromOffset(edge.X, edge.Y)
                d.arrow.Rotation = math.deg(math.atan2(dir.Y, dir.X))
                d.arrow.TextColor3 = F.esp.colors.arrow
                d.arrow.Visible = true
            else d.arrow.Visible = false end
        else d.arrow.Visible = false end

        if not (hrp and hum) then
            d.box.Visible = false; d.nameLbl.Visible = false; d.wLbl.Visible = false
            d.hpBg.Visible = false; d.tracer.Visible = false; d.hDot.Visible = false
            continue
        end

        local topW = head and (head.Position + Vector3.new(0,0.7,0))
            or (hrp.Position + Vector3.new(0,3,0))
        local botW = hrp.Position - Vector3.new(0,2.6,0)
        local tp, ton = cam:WorldToViewportPoint(topW)
        local bp, bon = cam:WorldToViewportPoint(botW)
        local on = ton and bon and tp.Z > 0 and bp.Z > 0

        if not on then
            d.box.Visible = false; d.nameLbl.Visible = false; d.wLbl.Visible = false
            d.hpBg.Visible = false; d.tracer.Visible = false; d.hDot.Visible = false
        else
            local h = math.abs(bp.Y - tp.Y)
            local w = h * 0.55
            local x = tp.X - w/2
            local y = tp.Y
            if F.esp.box or F.esp.filledBox then
                d.box.Position = UDim2.fromOffset(x, y)
                d.box.Size = UDim2.fromOffset(w, h)
                d.box.Visible = true
                local boxColor = F.esp.colors.box
                if F.cheat.cheaters[player.Name] then
                    boxColor = Color3.fromRGB(255, 60, 60)
                elseif F.mod.moderators[player.Name] then
                    boxColor = Color3.fromRGB(255, 170, 0)
                end
                d.box.BackgroundColor3 = boxColor
                d.box.BackgroundTransparency = F.esp.filledBox and 0.75 or 1
                d.strk.Color = boxColor
                d.strk.Transparency = F.esp.box and 0.1 or 1
            else d.box.Visible = false end

            if F.esp.name or F.esp.distance then
                local parts = {}
                local nmColor = F.esp.colors.name
                if F.esp.name then
                    local nmText = player.Name
                    if F.cheat.cheaters[player.Name] then
                        nmText = nmText .. " | Cheater"
                        nmColor = Color3.fromRGB(255, 60, 60)
                    elseif F.mod.moderators[player.Name] then
                        nmText = nmText .. " | Moderator"
                        nmColor = Color3.fromRGB(255, 170, 0)
                    end
                    d.nameLbl.TextColor3 = nmColor
                    table.insert(parts, nmText)
                end
                if F.esp.distance then
                    local dist = (camPos - hrp.Position).Magnitude
                    table.insert(parts, string.format("[%dm]", math.floor(dist)))
                end
                d.nameLbl.Text = table.concat(parts, "  ")
                d.nameLbl.Size = UDim2.fromOffset(math.max(w*1.8, 150), 18)
                d.nameLbl.Position = UDim2.fromOffset(x + w/2, y - 3)
                d.nameLbl.Visible = true
            else d.nameLbl.Visible = false end

            if F.esp.weapon then
                local weapon = getActiveWeapon(player)
                if weapon and weapon ~= "None" and weapon ~= "" then
                    d.wLbl.Text = "🔫 " .. weapon
                    d.wLbl.TextColor3 = F.esp.colors.weapon
                    d.wLbl.Size = UDim2.fromOffset(math.max(w*2, 160), 16)
                    d.wLbl.Position = UDim2.fromOffset(x + w/2, y + h + 3)
                    d.wLbl.Visible = true
                else d.wLbl.Visible = false end
            else d.wLbl.Visible = false end

            if F.esp.health then
                local pct = math.clamp(hum.Health / math.max(hum.MaxHealth,1), 0, 1)
                d.hpBg.Position = UDim2.fromOffset(x - 7, y)
                d.hpBg.Size = UDim2.fromOffset(4, h)
                d.hpBg.Visible = true
                d.hpBar.Position = UDim2.new(0, 0, pct, 0)
                d.hpBar.Size = UDim2.new(1, 0, pct, 0)
                d.hpBar.BackgroundColor3 = Color3.fromRGB(255*(1-pct), 255*pct, 0)
            else d.hpBg.Visible = false end

            if F.esp.tracers then
                local origin = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y)
                local target = Vector2.new(tp.X, tp.Y)
                drawLine(d.tracer, origin, target)
                d.tracer.BackgroundColor3 = F.esp.colors.tracers
            else d.tracer.Visible = false end

            if F.esp.headDot then
                d.hDot.Position = UDim2.fromOffset(tp.X, tp.Y - 6)
                d.hDot.BackgroundColor3 = F.esp.colors.headDot
                d.hDot.Visible = true
            else d.hDot.Visible = false end
        end
    end
end

