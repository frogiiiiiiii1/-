local function getViewModel()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    return cam:FindFirstChild("ViewModel")
end

local function matchesAimInput(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        return S.aim.bindType == "Key" and S.aim.keybind ~= nil
            and input.KeyCode == S.aim.keybind
    elseif input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.MouseButton2
        or input.UserInputType == Enum.UserInputType.MouseButton3 then
        return S.aim.bindType == "Mouse" and input.UserInputType == S.aim.bindMouse
    end
    return false
end

local function getAimPart(character)
    if not character then return nil end
    return character:FindFirstChild(S.aim.aimPart)
        or character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")
end

local function isVisible(targetModel, targetPart)
    if not S.aim.wallCheck then return true end
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local myHead = myChar:FindFirstChild("Head")
    if not myHead then return false end
    local origin = myHead.Position + Vector3.new(0, 1, 0)
    local dest = targetPart.Position
    local dir = dest - origin
    local dist = dir.Magnitude
    if dist < 0.5 then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { myChar }
    params.IgnoreWater = true
    local result = workspace:Raycast(origin, dir.Unit * dist, params)
    if not result then return true end
    local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
    if hitModel and hitModel:FindFirstChildOfClass("Humanoid") then return true end
    return false
end

local function inFov(screenPos)
    local cam = workspace.CurrentCamera
    if not cam then return false end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    return (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude <= S.aim.fovRadius
end

local function getPlayerClan(player)
    if not player then return nil end
    local plrs = ReplicatedStorage:FindFirstChild("Players")
    if not plrs then return nil end
    local entry = plrs:FindFirstChild(player.Name)
    if not entry then return nil end
    local status = entry:FindFirstChild("Status")
    if not status then return nil end
    local journey = status:FindFirstChild("Journey")
    if not journey then return nil end
    local clan = journey:FindFirstChild("Clan")
    if not clan then return nil end
    local v = clan:GetAttribute("CurrentClan")
    if v == nil then return nil end
    v = tostring(v)
    if v == "" or v == "nil" or v == "None" then return nil end
    return v
end

local function isSameTeam(player)
    if not S.aim.teamCheck then return false end
    local myClan = getPlayerClan(LocalPlayer)
    local theirClan = getPlayerClan(player)
    if not myClan then return false end
    if not theirClan then return false end
    return myClan == theirClan
end

local function isTargetValid(target)
    if not target then return false end
    local model = target.model
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local part = getAimPart(model)
    if not part then return false end
    local camera = workspace.CurrentCamera
    if not camera then return false end
    local sp, onScreen = camera:WorldToViewportPoint(part.Position)
    if not onScreen or sp.Z <= 0 then return false end
    if not inFov(sp) then return false end
    return true
end

local function findBestTarget()
    local camera = workspace.CurrentCamera
    if not camera then return nil end
    if S.aim.stickyAim and S.aim.lastTarget then
        if isTargetValid(S.aim.lastTarget) then
            local part = getAimPart(S.aim.lastTarget.model)
            if part then S.aim.lastTarget.part = part; return S.aim.lastTarget end
        end
    end
    local bestTarget, bestDist = nil, math.huge
    local vpCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    if S.aim.targetPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and not isSameTeam(plr) then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = getAimPart(plr.Character)
                    if part and isVisible(plr.Character, part) then
                        local sp, onScreen = camera:WorldToViewportPoint(part.Position)
                        if onScreen and sp.Z > 0 and inFov(sp) then
                            local d = (Vector2.new(sp.X, sp.Y) - vpCenter).Magnitude
                            if d < bestDist then
                                bestDist = d
                                bestTarget = { model = plr.Character, part = part, player = plr }
                            end
                        end
                    end
                end
            end
        end
    end
    if S.aim.targetAI then
        local aiZones = workspace:FindFirstChild("AiZones")
        if aiZones then
            for _, zone in ipairs(aiZones:GetChildren()) do
                for _, npc in ipairs(zone:GetChildren()) do
                    if npc:IsA("Model") then
                        local hum = npc:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            local part = getAimPart(npc)
                            if part and isVisible(npc, part) then
                                local sp, onScreen = camera:WorldToViewportPoint(part.Position)
                                if onScreen and sp.Z > 0 and inFov(sp) then
                                    local d = (Vector2.new(sp.X, sp.Y) - vpCenter).Magnitude
                                    if d < bestDist then
                                        bestDist = d
                                        bestTarget = { model = npc, part = part, player = nil }
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

local function getMuzzleVelocity()
    local plrs = ReplicatedStorage:FindFirstChild("Players")
    if not plrs then return 500 end
    local entry = plrs:FindFirstChild(LocalPlayer.Name)
    if not entry then return 500 end
    local status = entry:FindFirstChild("Status")
    local gpv = status and status:FindFirstChild("GameplayVariables")
    local eq = gpv and gpv:FindFirstChild("EquippedTool")
    local toolName = eq and eq.Value
    if not toolName or toolName == "" then return 500 end
    local inv = entry:FindFirstChild("Inventory")
    local tool = inv and inv:FindFirstChild(tostring(toolName))
    if not tool then return 500 end
    local att = tool:FindFirstChild("Attachments")
    if not att then return 500 end
    for _, a in ipairs(att:GetChildren()) do
        if a.Name:lower():find("mag") or a.Name:lower():find("rnd") then
            local loaded = a:FindFirstChild("LoadedAmmo")
            if loaded then
                local first = loaded:GetChildren()[1]
                if first then
                    local ammoType = first:GetAttribute("AmmoType")
                    if ammoType then
                        local ammoKey = tostring(ammoType)
                        if typeof(ammoType) == "Instance" then ammoKey = ammoType.Name end
                        local ammoList = ReplicatedStorage:FindFirstChild("AmmoTypes")
                        local ammo = ammoList and ammoList:FindFirstChild(ammoKey)
                        if ammo then return ammo:GetAttribute("MuzzleVelocity") or 500 end
                    end
                end
            end
        end
    end
    return 500
end

local function applyAimLock(target)
    if not target or not target.part then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    local targetPos = target.part.Position
    if S.aim.prediction then
        local hrp = target.model:FindFirstChild("HumanoidRootPart")
        if hrp then
            local myPos = camera.CFrame.Position
            local dist = (targetPos - myPos).Magnitude
            local mv = getMuzzleVelocity()
            local travel = dist / math.max(mv, 100) * 1.33
            local vel = hrp.AssemblyLinearVelocity
            targetPos = Vector3.new(
                targetPos.X + vel.X * travel, targetPos.Y, targetPos.Z + vel.Z * travel)
        end
    end
    local myPos = camera.CFrame.Position
    local newCF = CFrame.new(myPos, targetPos)
    local smooth = math.max(1, S.aim.smoothness)
    camera.CFrame = camera.CFrame:Lerp(newCF, 1 / smooth)
end

local function applySilentAim(target)
    if not target or not target.part then return end
    local vm = getViewModel()
    if not vm then return end
    local vmHRP = vm:FindFirstChild("HumanoidRootPart")
    if not vmHRP then return end
    local aimPos = target.part.Position - Vector3.new(0, S.aim.yOffset, 0)
    if S.aim.prediction then
        local hrp = target.model:FindFirstChild("HumanoidRootPart")
        if hrp then
            local myPos = vmHRP.Position
            local dist = (aimPos - myPos).Magnitude
            local mv = getMuzzleVelocity()
            local travel = dist / math.max(mv, 100) * 1.33
            local vel = hrp.AssemblyLinearVelocity
            aimPos = Vector3.new(
                target.part.Position.X + vel.X * travel,
                aimPos.Y,
                target.part.Position.Z + vel.Z * travel)
        end
    end
    vmHRP.CFrame = CFrame.new(vmHRP.Position, aimPos)
end

