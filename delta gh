        local bp = F.boss.frame.Position
        d["boss.pos"] = tostring(bp.X.Scale) .. "|" .. tostring(bp.X.Offset)
            .. "|" .. tostring(bp.Y.Scale) .. "|" .. tostring(bp.Y.Offset)
    elseif F.boss.savedPos then
        local bp = F.boss.savedPos
        d["boss.pos"] = tostring(bp.X.Scale) .. "|" .. tostring(bp.X.Offset)
            .. "|" .. tostring(bp.Y.Scale) .. "|" .. tostring(bp.Y.Offset)
    end
    return d
end

local function cfgSer(d)
    local l = {}
    for k, v in pairs(d) do table.insert(l, k .. "=" .. v) end
    table.sort(l)
    return table.concat(l, "\n")
end

local function cfgParse(txt)
    local d = {}
    for line in txt:gmatch("[^\r\n]+") do
        local k, v = line:match("^(.-)=(.*)$")
        if k and v then d[k] = v end
    end
    return d
end

local function cfgApply(data)
    if data["keybind.aimBindType"] == "Key" or data["keybind.aimBindType"] == "Mouse" then
        F.aim.bindType = data["keybind.aimBindType"]
    end
    if data["keybind.aim"] then
        local k = keyFromName(data["keybind.aim"])
        if k then F.aim.keybind = k end
    end
    if data["keybind.aimBindMouse"] then
        local m = mouseFromName(data["keybind.aimBindMouse"])
        if m then F.aim.bindMouse = m end
    end
    if data["keybind.zoom"] then
        local k = keyFromName(data["keybind.zoom"])
        if k then F.cam.zoomKey = k end
    end
    if data["keybind.thirdPerson"] then
        local k = keyFromName(data["keybind.thirdPerson"])
        if k then F.cam.thirdPersonKey = k end
    end
    if data["keybind.inventory"] then
        local k = keyFromName(data["keybind.inventory"])
        if k then F.inv.keybind = k end
    end
    if data["aim.mode"] == "Lock" or data["aim.mode"] == "Silent" then
        F.aim.mode = data["aim.mode"]
        if UI.dropdowns["Mode"] and UI.dropdowns["Mode"].set then
            UI.dropdowns["Mode"].set(data["aim.mode"])
        end
    end
    if data["boss.movable"] == "true" then F.boss.movable = true
    elseif data["boss.movable"] == "false" then F.boss.movable = false end
    if data["boss.pos"] then
        local xS, xO, yS, yO = data["boss.pos"]:match("([^|]+)|([^|]+)|([^|]+)|([^|]+)")
        if xS then
            F.boss.savedPos = UDim2.new(tonumber(xS), tonumber(xO),
                tonumber(yS), tonumber(yO))
            if F.boss.frame then F.boss.frame.Position = F.boss.savedPos end
        end
    end
    for k, v in pairs(data) do
        local pre, key = k:match("^(.-)%.(.+)$")
        pcall(function()
            if pre == "colorRow" then
                local api = UI.colorRows[key]
                if api and api.set then
                    local r,g,b = v:match("([%d%.]+)|([%d%.]+)|([%d%.]+)")
                    if r then api.set(Color3.new(tonumber(r), tonumber(g), tonumber(b))) end
                end
            elseif pre == "slider" then
                local api = UI.sliders[key]
                if api and api.set then api.set(tonumber(v) or 0) end
            elseif pre == "dropdown" and key ~= "Mode" then
                local api = UI.dropdowns[key]
                if api and api.set then api.set(v) end
            end
        end)
    end
    for k, v in pairs(data) do
        local pre, key = k:match("^(.-)%.(.+)$")
        if pre == "toggle" then
            local api = UI.toggles[key]
            if api and api.setEnabled then pcall(api.setEnabled, v == "true") end
        end
    end
    if UI.keybindUI["Aim Keybind"] then
        UI.keybindUI["Aim Keybind"].set(F.aim.bindType, F.aim.keybind, F.aim.bindMouse)
    end
    if UI.keybindUI["Zoom Key"] then
        UI.keybindUI["Zoom Key"].set("Key", F.cam.zoomKey, nil)
    end
    if UI.keybindUI["3P Keybind"] then
        UI.keybindUI["3P Keybind"].set("Key", F.cam.thirdPersonKey, nil)
    end
    if UI.keybindUI["Inventory Keybind"] then
        UI.keybindUI["Inventory Keybind"].set("Key", F.inv.keybind, nil)
    end
end

local function cfgSave(name)
    if not writefile then notify("Config", "writefile недоступен", 4); return false end
    local ok = pcall(writefile, F.cfg.PREFIX .. name .. ".txt", cfgSer(cfgData()))
    if ok then cfgAdd(name); notify("Config", "Saved: " .. name, 3); return true end
    notify("Config", "Ошибка сохранения", 4)
    return false
end

local function cfgLoadFile(name)
    if not readfile or not isfile then notify("Config", "readfile недоступен", 4); return false end
    local path = F.cfg.PREFIX .. name .. ".txt"
    local ok, exists = pcall(isfile, path)
    if not ok or not exists then notify("Config", "Файл не найден", 3); return false end
    local ok2, txt = pcall(readfile, path)
    if not ok2 or not txt then notify("Config", "Не прочитан", 3); return false end
    cfgApply(cfgParse(txt))
    notify("Config", "Loaded: " .. name, 3)
    return true
end

