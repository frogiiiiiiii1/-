        F.cheat.lastCheck = now
        for _, p in ipairs(Players:GetPlayers()) do checkCheater(p) end
    end
end)

local function checkMod(p)
    if p == LocalPlayer or not F.mod.enabled then return end
    if F.mod.moderators[p.Name] then return end
    local c = p.Character
    if not c then return end
    local plrs = RServ:FindFirstChild("Players")
    if plrs then
        local e = plrs:FindFirstChild(p.Name)
        local st = e and e:FindFirstChild("Status")
        local gpv = st and st:FindFirstChild("GameplayVariables")
        if gpv then
            local prem = gpv:GetAttribute("PremiumLevel")
            if prem and prem >= 4 then
                F.mod.moderators[p.Name] = true
                notify("Mod Detector", "Suspected: " .. p.Name, 5)
                return
            end
        end
    end
    for _, part in ipairs(c:GetChildren()) do
        if part:IsA("BasePart") and part.Transparency >= 1 then
            local n = part.Name
            if n == "Head" or n == "UpperTorso" or n == "LowerTorso"
                or n == "LeftUpperArm" or n == "RightUpperArm"
                or n == "LeftLowerArm" or n == "RightLowerArm"
                or n == "LeftUpperLeg" or n == "RightUpperLeg"
                or n == "LeftLowerLeg" or n == "RightLowerLeg"
                or n == "LeftFoot" or n == "RightFoot"
                or n == "LeftHand" or n == "RightHand" then
                F.mod.moderators[p.Name] = true
                notify("Mod Detector", "Invisible: " .. p.Name, 5)
                return
            end
        end
    end
end

