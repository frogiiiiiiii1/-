local function makeToggle(parent, name, order, defaultColor, callbacks)
    if type(callbacks) == "function" then
        callbacks = { onToggle = callbacks }
    elseif type(callbacks) ~= "table" then
        callbacks = {}
    end
    if defaultColor ~= nil and typeof(defaultColor) ~= "Color3" then defaultColor = nil end

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, cardHeight())
