local function invValue(inv)
    local total = 0
    local list = RServ:FindFirstChild("ItemsList")
    if not list then return 0 end
    for _, slot in ipairs(inv:GetChildren()) do
        local sa = slot:GetAttribute("Slot")
        if type(sa) == "string" and sa:find("Clothing") then
            local sub = slot:FindFirstChild("Inventory")
            if sub then
                for _, st in ipairs(sub:GetChildren()) do
                    local it = list:FindFirstChild(st.Name)
                    if it then
                        local pr = it:FindFirstChild("ItemProperties")
                        if pr then
                            if st.Name == "Rubles" then
                                total = total + (st:GetAttribute("Amount") or 1)
                            else
                                local price = pr:GetAttribute("Price") or 1
                                if price >= 10 then
                                    local t = pr:GetAttribute("ItemType")
                                    if t == "Extra" then price = price*0.4
                                    elseif t == "Ammo" then price = price*(st:GetAttribute("Amount") or 1)*0.7
                                    elseif t == "Clothing" then price = price*0.35
                                    elseif t == "Medical" then price = price*0.75
                                    elseif t == "Barter" then price = price*0.4 end
                                end
                                total = total + price
                            end
                        end
                    end
                end
            end
        end
    end
    return math.floor(total)
end

local function invRender(target)
    if not target then return end
    invClear()
    local inv = invContainer(target)
    if not inv then invInfo.Text = target.Name .. " (нет инвентаря)"; return end
    local wS, cS, aI = 1, 4, 0
    for _, item in ipairs(inv:GetChildren()) do
        local sa = item:GetAttribute("Slot")
        if type(sa) == "string" then
            if sa:find("Clothing") then
                local ic = invIcon(item.Name)
                if ic and cS <= 12 then
                    F.inv.hotbarSlots[cS].Image = ic; cS = cS + 1
                end
            elseif item:FindFirstChild("Attachments") then
                local ic = invIcon(item.Name)
                if ic and wS <= 12 then
                    F.inv.hotbarSlots[wS].Image = ic; wS = wS + 1
                end
                for _, att in ipairs(item.Attachments:GetChildren()) do
                    local as = att:GetAttribute("Slot")
                    local ai = invIcon(att.Name)
                    local idx = nil
                    if as == "Magazine" then idx = 1
                    elseif as == "Sight" then idx = 2
                    elseif as == "Muzzle" then idx = 3
                    elseif as == "Extra" then idx = 4 end
                    if idx and ai and (aI + idx) <= 12 then
                        F.inv.attachmentSlots[aI + idx].Image = ai
                    end
                end
                aI = aI + 4
            end
        end
    end
    if F.inv.showFull then
        local idx = 1
        for _, item in ipairs(inv:GetChildren()) do
            local sub = item:FindFirstChild("Inventory")
            if sub and item.Name ~= "KeyChain" then
                for _, st in ipairs(sub:GetChildren()) do
                    if idx > 54 then break end
                    local ic = invIcon(st.Name)
                    if ic then
                        F.inv.fullSlots[idx].Image = ic
                        local amt = st:GetAttribute("Amount") or 1
                        if amt >= 1000 then
                            F.inv.fullAmounts[idx].Text = tostring(math.floor(amt/1000)) .. "K"
                        else
                            F.inv.fullAmounts[idx].Text = "x" .. tostring(amt)
                        end
                    end
                    idx = idx + 1
                end
            end
        end
    end
    local parts = { target.Name }
    if F.inv.showValue then
        local cached = F.inv.valueCache[target.Name]
        local now = tick()
        local val
        if cached and (now - cached.time) < 3 then val = cached.value
        else
            val = invValue(inv)
            F.inv.valueCache[target.Name] = { value=val, time=now }
        end
        table.insert(parts, "$" .. tostring(val))
    end
    invInfo.Text = table.concat(parts, "  ·  ")
end

local function invNearest()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local vp = cam.ViewportSize
    local c = Vector2.new(vp.X/2, vp.Y/2)
    local maxD = math.min(vp.X, vp.Y)/2
    local nearest, nd = nil, math.huge
    local function chk(model, head)
        if not head or not head.Parent then return end
        local sp, on = cam:WorldToViewportPoint(head.Position)
        if not on or sp.Z <= 0 then return end
        local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
        if d < maxD and d < nd then nd = d; nearest = model end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            chk(plr, plr.Character:FindFirstChild("Head"))
        end
    end
    if F.inv.checkCorpses then
        local di = workspace:FindFirstChild("DroppedItems")
        if di then
            for _, cc in ipairs(di:GetChildren()) do
                if cc:FindFirstChild("Humanoid") and cc:FindFirstChild("Head") then
                    chk(cc, cc.Head)
                end
            end
        end
    end
    return nearest
end

