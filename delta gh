-- ViewModel update loop with SILENT-AIM COMPATIBILITY
local vmColAcc = 0
RunService.RenderStepped:Connect(function(dt)
    if not F.vm.enabled then return end
    local vm = F.vm.currentVM
    if not vm or not vm.Parent then return end

    -- silent aim compatibility:
    -- during aim hold — restore original C0 (no offsets) so silent aim isn't broken
    -- after release — apply user offsets again
    local off = Vector3.new(F.vm.offX, F.vm.offY, F.vm.offZ)
    local aimHolding = F.aim.enabled and F.aim.active

    for m, o in pairs(F.vm.motorOriginals) do
        if m and m.Parent then
            if aimHolding then
                m.C0 = o
            else
                m.C0 = o + off
            end
        end
    end

    vmColAcc = vmColAcc + dt
    if vmColAcc >= 0.1 then
        vmColAcc = 0
        for p, orig in pairs(F.vm.partOriginals) do
            if p and p.Parent then
                if vmIsArm(p.Name) then
                    p.Color = F.vm.armColor
                    p.Material = vmMat(F.vm.armMaterial)
                    p.Transparency = F.vm.armTransparency
                elseif vmIsW(p.Name) then
                    p.Color = F.vm.weaponColor
                    p.Material = vmMat(F.vm.weaponMaterial)
                    p.Transparency = F.vm.weaponTransparency
                end
            end
        end
    end
end)

local function vmRestore()
    for m, o in pairs(F.vm.motorOriginals) do
        if m and m.Parent then m.C0 = o end
    end
    for p, o in pairs(F.vm.partOriginals) do
        if p and p.Parent then
            p.Color = o.Color; p.Material = o.Material; p.Transparency = o.Transparency
        end
    end
end

