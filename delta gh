local function getAimPart(char)
    if not char then return nil end
    return char:FindFirstChild(F.aim.aimPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("HumanoidRootPart")
end

local function isActuallyVisible(targetModel, targetPart)
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local myHead = myChar:FindFirstChild("Head")
    if not myHead then return false end
    local origin = myHead.Position + Vector3.new(0,1,0)
    local dest = targetPart.Position
    local dir = dest - origin
    local dist = dir.Magnitude
    if dist < 0.5 then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { myChar }
    params.IgnoreWater = true
    local result = workspace:Raycast(origin, dir.Unit*dist, params)
    if not result then return true end
    local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
    if hitModel and hitModel:FindFirstChildOfClass("Humanoid") then return true end
    return false
end

local function aimIsVisible(targetModel, targetPart)
    if not F.aim.wallCheck then return true end
    return isActuallyVisible(targetModel, targetPart)
end

local function inFov(sp)
    local cam = workspace.CurrentCamera
    if not cam then return false end
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    return (Vector2.new(sp.X, sp.Y) - center).Magnitude <= F.aim.fovRadius
end

local function getClan(player)
    if not player then return nil end
    local plrs = RServ:FindFirstChild("Players")
    if not plrs then return nil end
    local e = plrs:FindFirstChild(player.Name)
    if not e then return nil end
    local st = e:FindFirstChild("Status")
    if not st then return nil end
    local jr = st:FindFirstChild("Journey")
    if not jr then return nil end
    local cl = jr:FindFirstChild("Clan")
    if not cl then return nil end
    local v = cl:GetAttribute("CurrentClan")
    if v == nil then return nil end
    v = tostring(v)
    if v == "" or v == "nil" or v == "None" then return nil end
    return v
end

local function isSameTeam(player)
    if not F.aim.teamCheck then return false end
    local m = getClan(LocalPlayer)
    local t = getClan(player)
    if not m or not t then return false end
    return m == t
end

local function isValidTarget(target)
    if not target then return false end
    local model = target.model
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local part = getAimPart(model)
    if not part then return false end
    local cam = workspace.CurrentCamera
    if not cam then return false end
    local sp, on = cam:WorldToViewportPoint(part.Position)
    if not on or sp.Z <= 0 then return false end
    if not inFov(sp) then return false end
    return true
end

local function findBestTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    if F.aim.stickyAim and F.aim.lastTarget then
        if isValidTarget(F.aim.lastTarget) then
            local part = getAimPart(F.aim.lastTarget.model)
            if part then F.aim.lastTarget.part = part; return F.aim.lastTarget end
        end
    end
    local best, bestDist = nil, math.huge
    local vpC = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    if F.aim.targetPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and not isSameTeam(plr) then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = getAimPart(plr.Character)
                    if part and aimIsVisible(plr.Character, part) then
                        local sp, on = cam:WorldToViewportPoint(part.Position)
                        if on and sp.Z > 0 and inFov(sp) then
                            local d = (Vector2.new(sp.X, sp.Y) - vpC).Magnitude
                            if d < bestDist then
                                bestDist = d
                                best = { model=plr.Character, part=part, player=plr }
                            end
                        end
                    end
                end
            end
        end
    end
    if F.aim.targetAI then
        local az = workspace:FindFirstChild("AiZones")
        if az then
            for _, z in ipairs(az:GetChildren()) do
                for _, n in ipairs(z:GetChildren()) do
                    if n:IsA("Model") then
                        local hum = n:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            local part = getAimPart(n)
                            if part and aimIsVisible(n, part) then
                                local sp, on = cam:WorldToViewportPoint(part.Position)
                                if on and sp.Z > 0 and inFov(sp) then
                                    local d = (Vector2.new(sp.X, sp.Y) - vpC).Magnitude
                                    if d < bestDist then
                                        bestDist = d
                                        best = { model=n, part=part, player=nil }
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function getMuzzleVelocity()
    local plrs = RServ:FindFirstChild("Players")
    if not plrs then return 500 end
    local e = plrs:FindFirstChild(LocalPlayer.Name)
    if not e then return 500 end
    local st = e:FindFirstChild("Status")
    local gpv = st and st:FindFirstChild("GameplayVariables")
    local eq = gpv and gpv:FindFirstChild("EquippedTool")
    local tn = eq and eq.Value
    if not tn or tn == "" then return 500 end
    local inv = e:FindFirstChild("Inventory")
    local tool = inv and inv:FindFirstChild(tostring(tn))
    if not tool then return 500 end
    local att = tool:FindFirstChild("Attachments")
    if not att then return 500 end
    for _, a in ipairs(att:GetChildren()) do
        if a.Name:lower():find("mag") or a.Name:lower():find("rnd") then
            local loaded = a:FindFirstChild("LoadedAmmo")
            if loaded then
                local first = loaded:GetChildren()[1]
                if first then
                    local at2 = first:GetAttribute("AmmoType")
                    if at2 then
                        local key = tostring(at2)
                        if typeof(at2) == "Instance" then key = at2.Name end
                        local list = RServ:FindFirstChild("AmmoTypes")
                        local ammo = list and list:FindFirstChild(key)
                        if ammo then return ammo:GetAttribute("MuzzleVelocity") or 500 end
                    end
                end
            end
        end
    end
    return 500
end

local function applyAimLock(target)
    if not target or not target.part then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local tp = target.part.Position
    if F.aim.prediction then
        local hrp = target.model:FindFirstChild("HumanoidRootPart")
        if hrp then
            local myPos = cam.CFrame.Position
            local dist = (tp - myPos).Magnitude
            local mv = getMuzzleVelocity()
            local travel = dist / math.max(mv, 100) * 1.33
            local vel = hrp.AssemblyLinearVelocity
            tp = Vector3.new(tp.X + vel.X*travel, tp.Y, tp.Z + vel.Z*travel)
        end
    end
    local myPos = cam.CFrame.Position
    local newCF = CFrame.new(myPos, tp)
    local smooth = math.max(1, F.aim.smoothness)
    cam.CFrame = cam.CFrame:Lerp(newCF, 1/smooth)
end

local function getVM()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    return cam:FindFirstChild("ViewModel")
end

local function applySilentAim(target)
    if not target or not target.part then return end
    local vm = getVM()
    if not vm then return end
    local vmHRP = vm:FindFirstChild("HumanoidRootPart")
    if not vmHRP then return end
    local aimPos = target.part.Position - Vector3.new(0, F.aim.yOffset, 0)
    vmHRP.CFrame = CFrame.new(vmHRP.Position, aimPos)
end

local warnedAS = false
local function autoShoot()
    if not F.aim.lastTarget then return end
    if type(mouse1press) ~= "function" or type(mouse1release) ~= "function" then
        if not warnedAS then warnedAS = true
            warn("[GootHub] AutoShoot: mouse1press not available") end
        return
    end
    pcall(function() mouse1press(); task.wait(0.02); mouse1release() end)
end

local function updateAimHL()
    if F.aim.espHighlight and F.aim.lastTarget and F.aim.lastTarget.model
        and F.aim.lastTarget.model.Parent then
        local model = F.aim.lastTarget.model
        if F.aim.currentHighlightModel ~= model then
            if F.aim.currentHighlight then F.aim.currentHighlight:Destroy() end
            local hl = Instance.new("Highlight")
            hl.Name = "CheatAimHL"
            hl.FillColor = F.aim.highlightColor
            hl.FillTransparency = 0.5
            hl.OutlineColor = F.aim.highlightColor
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = model
            hl.Parent = model
            F.aim.currentHighlight = hl
            F.aim.currentHighlightModel = model
        elseif F.aim.currentHighlight then
            F.aim.currentHighlight.FillColor = F.aim.highlightColor
            F.aim.currentHighlight.OutlineColor = F.aim.highlightColor
        end
    elseif F.aim.currentHighlight then
        F.aim.currentHighlight:Destroy()
        F.aim.currentHighlight = nil
        F.aim.currentHighlightModel = nil
    end
end

local function matchesAim(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        return F.aim.bindType == "Key" and F.aim.keybind and input.KeyCode == F.aim.keybind
    elseif input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.MouseButton2
        or input.UserInputType == Enum.UserInputType.MouseButton3 then
        return F.aim.bindType == "Mouse" and input.UserInputType == F.aim.bindMouse
    end
    return false
end

RunService.RenderStepped:Connect(function()
    if not F.aim.enabled then
        F.aim.lastTarget = nil
        targetLabel.Visible = false
        aimTracerLine.Visible = false
        updateAimHL()
        return
    end
    if not F.aim.active then
        F.aim.lastTarget = nil
        targetLabel.Visible = false
        aimTracerLine.Visible = false
        updateFovCircle()
        updateAimHL()
        return
    end
    local target = findBestTarget()
    F.aim.lastTarget = target
    updateFovCircle()
    updateAimHL()
    local cam = workspace.CurrentCamera
    if not cam then return end
    if target and (F.aim.showTarget or F.aim.showTargetVisible) then
        local nm = target.player and target.player.Name or target.model.Name
        if F.aim.showTargetVisible then
            local vis = isActuallyVisible(target.model, target.part)
            nm = nm .. " | " .. (vis and "SHOOOOT!!!" or "Hidden")
        end
        targetLabel.Text = nm
        targetLabel.Visible = true
    else targetLabel.Visible = false end
    if F.aim.aimbotTracer and target then
        local sp, on = cam:WorldToViewportPoint(target.part.Position)
        if on and sp.Z > 0 then
            local from = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
            local to = Vector2.new(sp.X, sp.Y)
            local d = to - from
            local len = d.Magnitude
            if len > 1 then
                local c = (from + to) * 0.5
                aimTracerLine.Position = UDim2.fromOffset(c.X, c.Y)
                aimTracerLine.Size = UDim2.fromOffset(len, 2)
                aimTracerLine.Rotation = math.deg(math.atan2(d.Y, d.X))
                aimTracerLine.BackgroundColor3 = F.aim.aimbotTracerColor
                aimTracerLine.Visible = true
            else aimTracerLine.Visible = false end
        else aimTracerLine.Visible = false end
    else aimTracerLine.Visible = false end
    if not target then return end
    if F.aim.mode == "Lock" then applyAimLock(target)
    elseif F.aim.mode == "Silent" then applySilentAim(target) end
    if F.aim.autoShoot then autoShoot() end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if F.aim.enabled and matchesAim(input) then F.aim.active = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if matchesAim(input) then F.aim.active = false end
end)

