    accentBar.BackgroundTransparency = 1
    accentBar.ZIndex = 12
    accentBar.Parent = Btn
    Instance.new("UICorner", accentBar).CornerRadius = UDim.new(1, 0)

    local Label = Instance.new("TextLabel")
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 14, 0, 0)
    Label.Text = name
    Label.TextColor3 = THEME.Text
    Label.Font = Enum.Font.GothamMedium
    Label.TextSize = S.menuApp.compactMode and 12 or 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.ZIndex = 12
    Label.Parent = Btn

    local colorSwatch
    if defaultColor then
        Label.Size = UDim2.new(1, -90, 1, 0)
        colorSwatch = Instance.new("TextButton")
        colorSwatch.Size = UDim2.fromOffset(22, 22)
        colorSwatch.Position = UDim2.new(1, -76, 0.5, -11)
        colorSwatch.BackgroundColor3 = defaultColor
        colorSwatch.BorderSizePixel = 0
        colorSwatch.Text = ""
        colorSwatch.AutoButtonColor = false
        colorSwatch.ZIndex = 12
        colorSwatch.Parent = Btn
        Instance.new("UICorner", colorSwatch).CornerRadius = UDim.new(0, 5)
        local cs = Instance.new("UIStroke", colorSwatch)
        cs.Color = Color3.fromRGB(0,0,0); cs.Thickness = 1; cs.Transparency = 0.6
        colorSwatch.MouseButton1Click:Connect(function()
            showColorPicker(colorSwatch, colorSwatch.BackgroundColor3, function(c)
                colorSwatch.BackgroundColor3 = c
                if callbacks.onColor then callbacks.onColor(c) end
            end)
        end)
    else
        Label.Size = UDim2.new(1, -60, 1, 0)
    end

    local Pill = Instance.new("Frame")
    Pill.Size = UDim2.fromOffset(34, 18)
    Pill.Position = UDim2.new(1, -46, 0.5, -9)
    Pill.BackgroundColor3 = THEME.PillOff
    Pill.BorderSizePixel = 0
    Pill.ZIndex = 12
    Pill.Parent = Btn
    Instance.new("UICorner", Pill).CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.fromOffset(14, 14)
    Knob.Position = UDim2.new(0, 2, 0.5, -7)
    Knob.BackgroundColor3 = Color3.fromRGB(230,230,235)
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 13
    Knob.Parent = Pill
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    local state = false
    local function render(s)
        state = s
        TweenService:Create(Btn, TweenInfo.new(0.15), { BackgroundColor3 = s and THEME.BgCardOn or THEME.BgCard }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.15), {
            Color = s and THEME.Accent or THEME.Border,
            Transparency = s and 0.4 or 0.5 }):Play()
        TweenService:Create(accentBar, TweenInfo.new(0.15), { BackgroundTransparency = s and 0 or 1 }):Play()
        TweenService:Create(Pill, TweenInfo.new(0.15), { BackgroundColor3 = s and THEME.Accent or THEME.PillOff }):Play()
        TweenService:Create(Knob, TweenInfo.new(0.18, Enum.EasingStyle.Quart), {
            BackgroundColor3 = s and THEME.TextOn or Color3.fromRGB(230,230,235),
            Position = s and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7) }):Play()
        Label.TextColor3 = s and THEME.TextOn or THEME.Text
    end
    Btn.MouseEnter:Connect(function()
        if not state then TweenService:Create(Btn, TweenInfo.new(0.12), { BackgroundColor3 = THEME.BgCardHover }):Play() end
    end)
    Btn.MouseLeave:Connect(function()
        if not state then TweenService:Create(Btn, TweenInfo.new(0.12), { BackgroundColor3 = THEME.BgCard }):Play() end
    end)
    Btn.MouseButton1Click:Connect(function()
        render(not state)
        if callbacks.onToggle then callbacks.onToggle(state) end
    end)
    render(false)
    local api = {}
    api.setEnabled = function(v)
        if v == state then return end
        render(v)
        if callbacks.onToggle then callbacks.onToggle(v) end
    end
    api.getEnabled = function() return state end
    S.toggles[name] = api
    return api
end

