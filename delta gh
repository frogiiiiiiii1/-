    rightLbl.TextColor3 = THEME.AccentGlow
    rightLbl.Font = Enum.Font.GothamBold
    rightLbl.TextSize = S.menuApp.compactMode and 11 or 12
    rightLbl.TextXAlignment = Enum.TextXAlignment.Right
    rightLbl.ZIndex = 12
    rightLbl.Parent = btn

    local waiting = false
    btn.MouseButton1Click:Connect(function()
        waiting = true
        rightLbl.Text = "..."
        rightLbl.TextColor3 = THEME.Danger
    end)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if not waiting then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.MouseButton2
            or input.UserInputType == Enum.UserInputType.MouseButton3 then
            waiting = false
            rightLbl.Text = mouseName(input.UserInputType)
            rightLbl.TextColor3 = THEME.AccentGlow
            callback("Mouse", input.UserInputType, nil)
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.Unknown then return end
            if input.KeyCode == Enum.KeyCode.Escape then
                waiting = false
                rightLbl.Text = bindDisplay(bindType, initialKey, initialMouse)
                rightLbl.TextColor3 = THEME.AccentGlow
                return
            end
            waiting = false
            rightLbl.Text = keyName(input.KeyCode)
            rightLbl.TextColor3 = THEME.AccentGlow
            callback("Key", nil, input.KeyCode)
        end
    end)

    S.keybindUI[name] = {
        set = function(bt, k, m)
            if bt then bindType = bt end
            if k ~= nil then initialKey = k end
            if m ~= nil then initialMouse = m end
            rightLbl.Text = bindDisplay(bindType, initialKey, initialMouse)
        end,
        get = function() return bindType, initialKey, initialMouse end,
    }
    return btn
end

