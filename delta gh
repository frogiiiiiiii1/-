local function gmCacheAmmo(ammo)
    if S.gunMods.cached[ammo] then return end
    S.gunMods.cached[ammo] = {
        Recoil = ammo:GetAttribute("RecoilStrength"),
        Drop   = ammo:GetAttribute("ProjectileDrop"),
        Drag   = ammo:GetAttribute("Drag"),
    }
end

local function applyGunMods()
    local ammoTypes = ReplicatedStorage:FindFirstChild("AmmoTypes")
    if not ammoTypes then return end
    for _, ammo in ipairs(ammoTypes:GetChildren()) do
        gmCacheAmmo(ammo)
        local orig = S.gunMods.cached[ammo]
        if S.gunMods.noRecoil then
            ammo:SetAttribute("RecoilStrength", 0)
        elseif orig.Recoil ~= nil then
            ammo:SetAttribute("RecoilStrength", orig.Recoil)
        end
        if S.gunMods.noDrop then
            ammo:SetAttribute("ProjectileDrop", 0)
        elseif orig.Drop ~= nil then
            ammo:SetAttribute("ProjectileDrop", orig.Drop)
        end
        if S.gunMods.noDrag then
            ammo:SetAttribute("Drag", 0)
        elseif orig.Drag ~= nil then
            ammo:SetAttribute("Drag", orig.Drag)
        end
    end
end

local function restoreGunMods()
    for ammo, orig in pairs(S.gunMods.cached) do
        if ammo and ammo.Parent then
            if orig.Recoil ~= nil then ammo:SetAttribute("RecoilStrength", orig.Recoil) end
            if orig.Drop ~= nil then ammo:SetAttribute("ProjectileDrop", orig.Drop) end
            if orig.Drag ~= nil then ammo:SetAttribute("Drag", orig.Drag) end
        end
    end
end

