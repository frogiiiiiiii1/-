UI.OriginalMainPos = UI.Main.Position
UI.originalSize = UDim2.fromOffset(UI.menuApp.width, UI.menuApp.height)

local function animateMenuOpen(silent)
    if UI.busyAnim then return end
    UI.busyAnim = true
    UI.isOpen = true
    UI.Backdrop.Visible = true
    UI.Backdrop.BackgroundTransparency = 1
    TweenService:Create(UI.Backdrop, TweenInfo.new(0.45, Enum.EasingStyle.Quart),
        {BackgroundTransparency=0}):Play()

    UI.Main.Visible = true
    UI.Main.Size = UDim2.new(0, UI.originalSize.X.Offset*0.85, 0, UI.originalSize.Y.Offset*0.85)
    UI.Main.Position = UDim2.new(UI.OriginalMainPos.X.Scale, UI.OriginalMainPos.X.Offset,
        UI.OriginalMainPos.Y.Scale, UI.OriginalMainPos.Y.Offset + 24)
    UI.Main.BackgroundTransparency = 1

    local base = UI.menuApp.transparency
    local restoreList = {}
    for _, obj in ipairs(UI.Main:GetDescendants()) do
        if obj:IsA("TextLabel") then
            restoreList[obj] = {prop="TextTransparency", val=obj.TextTransparency}
            obj.TextTransparency = 1
        elseif obj:IsA("TextButton") then
            restoreList[obj] = {prop="TextTransparency", val=obj.TextTransparency}
            obj.TextTransparency = 1
        elseif obj:IsA("ImageLabel") then
            restoreList[obj] = {prop="ImageTransparency", val=obj.ImageTransparency}
            obj.ImageTransparency = math.min(obj.ImageTransparency + 0.5, 1)
        end
    end

    TweenService:Create(UI.Main, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Size=UI.originalSize, Position=UI.OriginalMainPos, BackgroundTransparency=base}):Play()

    for obj, info in pairs(restoreList) do
        if obj and obj.Parent then
            TweenService:Create(obj, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
                {[info.prop] = info.val}):Play()
        end
    end
    task.delay(0.55, function()
        UI.busyAnim = false
        if not silent then setStatus("menu opened") end
    end)
end

local function animateMenuHide(silent)
    if UI.busyAnim or not UI.Main.Visible then return end
    UI.busyAnim = true
    UI.isOpen = false
    local base = UI.Main.BackgroundTransparency
    local restoreList = {}
    for _, obj in ipairs(UI.Main:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            restoreList[obj] = "TextTransparency"
        elseif obj:IsA("ImageLabel") then
            restoreList[obj] = "ImageTransparency"
        end
    end
    local t = TweenService:Create(UI.Main,
        TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, UI.originalSize.X.Offset*0.88, 0, UI.originalSize.Y.Offset*0.88),
        Position = UDim2.new(UI.OriginalMainPos.X.Scale, UI.OriginalMainPos.X.Offset,
            UI.OriginalMainPos.Y.Scale, UI.OriginalMainPos.Y.Offset + 18),
        BackgroundTransparency = 1 })
    t:Play()
    for obj, prop in pairs(restoreList) do
        if obj and obj.Parent then
            TweenService:Create(obj, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
                {[prop] = 1}):Play()
        end
    end
    TweenService:Create(UI.Backdrop, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
        {BackgroundTransparency=1}):Play()
    t.Completed:Connect(function()
        UI.Main.Visible = false
        UI.Backdrop.Visible = false
        UI.Main.Size = UI.originalSize
        UI.Main.Position = UI.OriginalMainPos
        UI.Main.BackgroundTransparency = base
        for obj, prop in pairs(restoreList) do
            if obj and obj.Parent then obj[prop] = 0 end
        end
        UI.busyAnim = false
        if not silent then setStatus("menu hidden") end
    end)
end

local function toggleMenu(silent)
    if UI.busyAnim then return end
    if UI.isOpen then animateMenuHide(silent)
    else animateMenuOpen(silent) end
end

