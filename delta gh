local function makeCrosshairLine()
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    f.BorderSizePixel = 0
    f.ZIndex = 3
    f.Parent = crosshairContainer
    return f
end
local crosshairLines = { top=makeCrosshairLine(), bottom=makeCrosshairLine(),
    left=makeCrosshairLine(), right=makeCrosshairLine() }

local function updateCrosshair()
    local ch = S.crosshair
    local gap, len, thick = ch.gap, ch.length, ch.thickness
    local trans, col = 1 - ch.transparency, ch.color
    crosshairLines.top.Size = UDim2.fromOffset(thick, len)
    crosshairLines.top.Position = UDim2.new(0.5, 0, 0.5, -(gap + len / 2))
    crosshairLines.top.BackgroundColor3 = col
    crosshairLines.top.BackgroundTransparency = trans
    crosshairLines.bottom.Size = UDim2.fromOffset(thick, len)
    crosshairLines.bottom.Position = UDim2.new(0.5, 0, 0.5, gap + len / 2)
    crosshairLines.bottom.BackgroundColor3 = col
    crosshairLines.bottom.BackgroundTransparency = trans
    crosshairLines.left.Size = UDim2.fromOffset(len, thick)
    crosshairLines.left.Position = UDim2.new(0.5, -(gap + len / 2), 0.5, 0)
    crosshairLines.left.BackgroundColor3 = col
    crosshairLines.left.BackgroundTransparency = trans
    crosshairLines.right.Size = UDim2.fromOffset(len, thick)
    crosshairLines.right.Position = UDim2.new(0.5, gap + len / 2, 0.5, 0)
    crosshairLines.right.BackgroundColor3 = col
    crosshairLines.right.BackgroundTransparency = trans
    crosshairContainer.Visible = ch.visible
end

local function updateFovCircle()
    local r = S.aim.fovRadius
    fovCircle.Size = UDim2.fromOffset(r * 2, r * 2)
    local col = S.aim.fovColor
    if S.aim.fovDynamicColor and S.aim.lastTarget then col = S.aim.fovTargetColor end
    fovStroke.Color = col
    fovStroke.Thickness = S.aim.fovThickness
    fovStroke.Transparency = S.aim.fovTransparency
    fovCircle.Visible = S.aim.fovVisible and S.aim.enabled
end

