local function checkCheater(player)
    if player == LocalPlayer or not S.cheaterDet.enabled then return end
    if S.cheaterDet.cheaters[player.Name] then return end
    local plrs = ReplicatedStorage:FindFirstChild("Players")
    if not plrs then return end
    local pEntry = plrs:FindFirstChild(player.Name)
    local status = pEntry and pEntry:FindFirstChild("Status")
    local journey = status and status:FindFirstChild("Journey")
    local wipe = journey and journey:FindFirstChild("WipeStatistics")
    if not wipe then return end
    local deaths = wipe:GetAttribute("Deaths") or 0; if deaths == 0 then deaths = 1 end
    local kills = wipe:GetAttribute("Kills") or 0; if kills == 0 then kills = 1 end
    local kdr = math.floor(kills / deaths * 10) / 10
    local reportList = ReplicatedStorage:FindFirstChild("ReportList")
    local report = reportList and (reportList:FindFirstChild("MostWanted") or reportList:FindFirstChild("Recent"))
    local flags, hsr, age = 0, 0, 999
    if report then
        local r = report:FindFirstChild(player.Name)
        if r then
            flags = r:GetAttribute("TotalFlags") or 0
            hsr = r:GetAttribute("HSR") or 0
            age = r:GetAttribute("Age") or 999
        end
    end
    if kills >= 15 and hsr >= 95 then
        S.cheaterDet.cheaters[player.Name] = true
        notify("Cheater Detector (B)", player.Name .. " | KDR: " .. kdr, 5)
    end
    if flags >= 75 and age <= 50 then
        S.cheaterDet.cheaters[player.Name] = true
        notify("Cheater Detector (C)", player.Name .. " | KDR: " .. kdr, 5)
    end
    if kills >= 15 and kdr >= 5 then
        S.cheaterDet.cheaters[player.Name] = true
        notify("Cheater Detector (A)", player.Name .. " | KDR: " .. kdr, 5)
    end
end

RunService.Heartbeat:Connect(function()
    if not S.cheaterDet.enabled then return end
    local now = tick()
    if now - S.cheaterDet.lastCheck >= 10 then
        S.cheaterDet.lastCheck = now
        for _, p in ipairs(Players:GetPlayers()) do checkCheater(p) end
    end
end)

local function checkMod(player)
    if player == LocalPlayer or not S.modDet.enabled then return end
    if S.modDet.moderators[player.Name] then return end
    local char = player.Character
    if not char then return end
    local plrs = ReplicatedStorage:FindFirstChild("Players")
    if plrs then
        local entry = plrs:FindFirstChild(player.Name)
        local status = entry and entry:FindFirstChild("Status")
        local gpv = status and status:FindFirstChild("GameplayVariables")
        if gpv then
            local prem = gpv:GetAttribute("PremiumLevel")
            if prem and prem >= 4 then
                S.modDet.moderators[player.Name] = true
                notify("Mod Detector (Prem)", "Suspected: " .. player.Name, 5)
                return
            end
        end
    end
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and part.Transparency >= 1 then
            local n = part.Name
            if n == "Head" or n == "UpperTorso" or n == "LowerTorso"
                or n == "LeftUpperArm" or n == "RightUpperArm"
                or n == "LeftLowerArm" or n == "RightLowerArm"
                or n == "LeftUpperLeg" or n == "RightUpperLeg"
                or n == "LeftLowerLeg" or n == "RightLowerLeg"
                or n == "LeftFoot" or n == "RightFoot"
                or n == "LeftHand" or n == "RightHand" then
                S.modDet.moderators[player.Name] = true
                notify("Mod Detector (Invis)", "Suspected: " .. player.Name, 5)
                return
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    if not S.modDet.enabled then return end
    local now = tick()
    if now - S.modDet.lastCheck >= 10 then
        S.modDet.lastCheck = now
        for _, p in ipairs(Players:GetPlayers()) do checkMod(p) end
    end
end)

