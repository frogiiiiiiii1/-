-- MAIN LOOPS
task.spawn(function()
	local cam, t = nil, 0
	repeat cam = workspace.CurrentCamera; task.wait(0.1); t += 0.1 until (cam and cam.Parent) or t > 15
	task.wait(1.5)
	cam = workspace.CurrentCamera
	if cam then
		S.baseFOV = cam.FieldOfView
		cam.FieldOfView = S.baseFOV
		writeFOVToGame(S.baseFOV)
	end
	S.fovLockEnabled = true
end)

local function hookPlayer(p)
	if p == LocalPlayer then return end
	if S.espConns[p] then return end
	S.espConns[p] = p.CharacterAdded:Connect(function()
		if S.espData[p] then removeESP(p) end
		task.wait(0.4)
		if S.espActive then createESP(p) end
		if S.cheaterDet.enabled then task.wait(2); checkCheater(p) end
		if S.modDet.enabled then task.wait(2); checkMod(p) end
	end)
end

local function unhookPlayer(p)
	local conn = S.espConns[p]
	if conn then conn:Disconnect(); S.espConns[p] = nil end
	removeESP(p)
	S.INV.valueCache[p.Name] = nil
	S.cheaterDet.cheaters[p.Name] = nil
	S.modDet.moderators[p.Name] = nil
end

for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
Players.PlayerAdded:Connect(hookPlayer)
Players.PlayerRemoving:Connect(unhookPlayer)

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.5)
	if S.espActive then
		for p in pairs(S.espData) do removeESP(p) end
		for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
	end
end)

RunService.RenderStepped:Connect(updateESP)

RunService.RenderStepped:Connect(function(dt)
	if not S.aim.enabled then
		S.aim.lastTarget = nil
		targetLabel.Visible = false
		aimTracer.Visible = false
		updateHighlight()
		return
	end
	if not S.aim.active then
		S.aim.lastTarget = nil
		targetLabel.Visible = false
		aimTracer.Visible = false
		updateFovCircle()
		updateHighlight()
		return
	end
	local target = findBestTarget()
	S.aim.lastTarget = target
	updateFovCircle()
	updateHighlight()
	local camera = workspace.CurrentCamera
	if not camera then return end
	if target and (S.aim.showTarget or S.aim.showTargetVisible) then
		local nameStr = target.player and target.player.Name or target.model.Name
		if S.aim.showTargetVisible then
			local vis = isVisible(target.model, target.part)
			nameStr = nameStr .. "  |  " .. (vis and "SHOOOOT!!!" or "Hidden")
		end
		targetLabel.Text = nameStr
		targetLabel.Visible = true
	else targetLabel.Visible = false end
	if S.aim.aimbotTracer and target then
		local sp, onScreen = camera:WorldToViewportPoint(target.part.Position)
		if onScreen and sp.Z > 0 then
			local from = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
			local to = Vector2.new(sp.X, sp.Y)
			local delta = to - from
			local length = delta.Magnitude
			if length > 1 then
				local center = (from + to) * 0.5
				aimTracer.Position = UDim2.fromOffset(center.X, center.Y)
				aimTracer.Size = UDim2.fromOffset(length, 2)
				aimTracer.Rotation = math.deg(math.atan2(delta.Y, delta.X))
				aimTracer.BackgroundColor3 = S.aim.aimbotTracerColor
				aimTracer.Visible = true
			else aimTracer.Visible = false end
		else aimTracer.Visible = false end
	else aimTracer.Visible = false end
	if not target then return end
	if S.aim.mode == "Lock" then
		applyAimLock(target)
	elseif S.aim.mode == "Silent" then
		applySilentAim(target)
	end
	if S.aim.autoShoot then
		S.shootAccum += dt
		if S.shootAccum >= 0.05 then
			S.shootAccum = 0
			autoShoot()
		end
	end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if not S.aim.enabled then return end
	if matchesAimInput(input) then S.aim.active = true end
end)
UserInputService.InputEnded:Connect(function(input)
	if matchesAimInput(input) then S.aim.active = false end
end)

