local function applyCorpseESP(enable)
	S.new.corpseESP = enable
	local di = workspace:FindFirstChild("DroppedItems")
	if not di then return end
	local function addTag(c)
		if c:FindFirstChild("Humanoid") and not c:FindFirstChild("CheatCorpseTag") then
			local bb = corpseTemplate:Clone()
			bb.Label.Text = c.Name .. " | Corpse"
			bb.Label.TextColor3 = (c.Name == LocalPlayer.Name)
				and Color3.fromRGB(255, 102, 0) or Color3.fromRGB(0, 255, 0)
			bb.Parent = c
		end
	end
	if enable then
		for _, c in ipairs(di:GetChildren()) do addTag(c) end
		if S.newConns.corpseAdded then S.newConns.corpseAdded:Disconnect() end
		S.newConns.corpseAdded = di.ChildAdded:Connect(function(c)
			if S.new.corpseESP then task.wait(0.05); if c and c.Parent then addTag(c) end end
		end)
	else
		for _, c in ipairs(di:GetChildren()) do
			local tag = c:FindFirstChild("CheatCorpseTag"); if tag then tag:Destroy() end
		end
		if S.newConns.corpseAdded then S.newConns.corpseAdded:Disconnect(); S.newConns.corpseAdded = nil end
	end
end

