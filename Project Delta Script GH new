local activeColorPicker, colorPickerCloseConn = nil, nil

local function destroyColorPicker()
	if colorPickerCloseConn then colorPickerCloseConn:Disconnect(); colorPickerCloseConn = nil end
	if activeColorPicker then activeColorPicker:Destroy(); activeColorPicker = nil end
end

local function showColorPicker(anchor, initialColor, callback)
	if typeof(initialColor) ~= "Color3" then initialColor = Color3.fromRGB(255,255,255) end
	destroyColorPicker()
	local popup = Instance.new("Frame")
	popup.Size = UDim2.fromOffset(240, 120)
	popup.BackgroundColor3 = THEME.BgDark
	popup.BorderSizePixel = 0
	popup.Active = true
	popup.ZIndex = 5000
	popup.Parent = ScreenGui
	Instance.new("UICorner", popup).CornerRadius = UDim.new(0, 8)
	local ps = Instance.new("UIStroke", popup)
	ps.Color = THEME.Accent; ps.Thickness = 1
	activeColorPicker = popup

	local vp = workspace.CurrentCamera.ViewportSize
	local ax, ay = anchor.AbsolutePosition.X, anchor.AbsolutePosition.Y
	local px = ax - 248
	if px < 8 then px = ax + anchor.AbsoluteSize.X + 8 end
	if px + 240 > vp.X - 8 then px = vp.X - 248 end
	local py = ay
	if py + 120 > vp.Y - 8 then py = vp.Y - 128 end
	if py < 8 then py = 8 end
	popup.Position = UDim2.fromOffset(px, py)

	local closeBtn = Instance.new("TextButton")
	closeBtn.Size = UDim2.fromOffset(20, 20)
	closeBtn.Position = UDim2.new(1, -24, 0, 4)
	closeBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 60)
	closeBtn.BorderSizePixel = 0
	closeBtn.Text = "✕"
	closeBtn.TextColor3 = THEME.TextOn
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.TextSize = 12
	closeBtn.AutoButtonColor = false
	closeBtn.ZIndex = 5001
	closeBtn.Parent = popup
	Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 4)
	closeBtn.MouseButton1Click:Connect(destroyColorPicker)

	local preview = Instance.new("Frame")
	preview.Size = UDim2.fromOffset(60, 60)
	preview.Position = UDim2.fromOffset(12, 30)
	preview.BackgroundColor3 = initialColor
	preview.BorderSizePixel = 0
	preview.ZIndex = 5001
	preview.Parent = popup
	Instance.new("UICorner", preview).CornerRadius = UDim.new(0, 6)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromOffset(150, 18)
	title.Position = UDim2.fromOffset(12, 6)
	title.BackgroundTransparency = 1
	title.Text = "COLOR PICKER"
