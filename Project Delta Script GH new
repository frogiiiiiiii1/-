local function getMaterial(name)
	local ok, mat = pcall(function() return Enum.Material[name] end)
	if ok and mat then return mat end
	return Enum.Material.Plastic
end
local function isArmPart(name) return VMC.ARM_PARTS[name] == true end
local function isWeaponPart(name)
	if VMC.ARM_PARTS[name] or VMC.SKIP_PARTS[name] then return false end
	return true
end

local function collectTargetMotors(vm)
	local hrp = vm:FindFirstChild("HumanoidRootPart")
	if not hrp then return {} end
	local result = {}
	for _, name in ipairs(VMC.TARGET_MOTORS) do
		local obj = hrp:FindFirstChild(name)
		if obj and obj:IsA("Motor6D") then table.insert(result, obj) end
	end
	if #result == 0 then
		for _, name in ipairs(VMC.TARGET_MOTORS) do
			local obj = vm:FindFirstChild(name)
			if obj and obj:IsA("Motor6D") then table.insert(result, obj) end
		end
	end
	return result
end

local function captureVM(vm)
	S.vm.motorOriginals = {}
	S.vm.partOriginals = {}
	for _, m in ipairs(collectTargetMotors(vm)) do
		S.vm.motorOriginals[m] = m.C0
	end
	for _, d in ipairs(vm:GetDescendants()) do
		if d:IsA("BasePart") then
			if isWeaponPart(d.Name) then
				local sa = d:FindFirstChildOfClass("SurfaceAppearance")
				if sa then sa:Destroy() end
			end
			S.vm.partOriginals[d] = { Color = d.Color, Material = d.Material, Transparency = d.Transparency }
		end
	end
end

local function hookViewModel(vm)
	S.vm.currentVM = vm
	captureVM(vm)
	if S.vm.vmConn then S.vm.vmConn:Disconnect(); S.vm.vmConn = nil end
	S.vm.vmConn = vm.DescendantAdded:Connect(function(d)
		if d:IsA("Motor6D") then
			for _, name in ipairs(VMC.TARGET_MOTORS) do
				if d.Name == name and not S.vm.motorOriginals[d] then
					S.vm.motorOriginals[d] = d.C0
				end
			end
		elseif d:IsA("BasePart") then
			if not S.vm.partOriginals[d] then
				S.vm.partOriginals[d] = { Color = d.Color, Material = d.Material, Transparency = d.Transparency }
			end
		end
	end)
end

task.spawn(function()
	local cam, t = nil, 0
	repeat cam = workspace.CurrentCamera; task.wait(0.1); t += 0.1 until (cam and cam.Parent) or t > 15
	if not cam then return end
	local vm = cam:FindFirstChild("ViewModel")
	if vm then hookViewModel(vm) end
	cam.DescendantAdded:Connect(function(desc)
		if desc.Name == "ViewModel" and desc:IsA("Model") then
			task.wait(0.15); hookViewModel(desc)
		end
	end)
end)

local function applyOffsets()
	local vm = S.vm.currentVM
	if not vm or not vm.Parent then return end
	local delta = Vector3.new(S.vm.offX, S.vm.offY, S.vm.offZ)
	for motor, origC0 in pairs(S.vm.motorOriginals) do
		if motor and motor.Parent then motor.C0 = origC0 + delta end
	end
end

local function applyColors()
	for part, orig in pairs(S.vm.partOriginals) do
		if part and part.Parent then
			if isArmPart(part.Name) then
				part.Color = S.vm.armColor
				part.Material = getMaterial(S.vm.armMaterial)
				part.Transparency = S.vm.armTransparency
			elseif isWeaponPart(part.Name) then
				part.Color = S.vm.weaponColor
				part.Material = getMaterial(S.vm.weaponMaterial)
				part.Transparency = S.vm.weaponTransparency
			end
		end
	end
end

local function restoreVM()
	for motor, origC0 in pairs(S.vm.motorOriginals) do
		if motor and motor.Parent then motor.C0 = origC0 end
	end
	for part, orig in pairs(S.vm.partOriginals) do
		if part and part.Parent then
			part.Color = orig.Color; part.Material = orig.Material; part.Transparency = orig.Transparency
		end
	end
end

RunService.RenderStepped:Connect(function(dt)
	if not S.vm.enabled then return end
	local vm = S.vm.currentVM
	if not vm or not vm.Parent then return end
	applyOffsets()
	S.colorAccum += dt
	if S.colorAccum >= 0.1 then S.colorAccum = 0; applyColors() end
end)

