			if not scroll.Visible then btn.BackgroundColor3 = THEME.BgHover end end)
		btn.MouseLeave:Connect(function()
			if not scroll.Visible then btn.BackgroundColor3 = THEME.BgButton end end)

		return scroll, select
	end
	return page, addSubTab
end

