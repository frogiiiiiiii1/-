	title.TextSize = 11
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.ZIndex = 5001
	title.Parent = popup

	local r = math.floor(initialColor.R * 255 + 0.5)
	local g = math.floor(initialColor.G * 255 + 0.5)
	local b = math.floor(initialColor.B * 255 + 0.5)

	local function applyColor()
		local col = Color3.fromRGB(r, g, b)
		preview.BackgroundColor3 = col
		callback(col)
	end

	local function makeChannel(labelText, y, getter, setter, fillColor)
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.fromOffset(20, 16)
		lbl.Position = UDim2.fromOffset(80, y)
		lbl.BackgroundTransparency = 1
		lbl.Text = labelText
		lbl.TextColor3 = THEME.Text
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 12
		lbl.ZIndex = 5001
		lbl.Parent = popup
		local valLbl = Instance.new("TextLabel")
		valLbl.Size = UDim2.fromOffset(34, 16)
		valLbl.Position = UDim2.fromOffset(198, y)
		valLbl.BackgroundTransparency = 1
		valLbl.Text = tostring(getter())
		valLbl.TextColor3 = THEME.TextDim
		valLbl.Font = Enum.Font.Gotham
		valLbl.TextSize = 11
		valLbl.TextXAlignment = Enum.TextXAlignment.Right
		valLbl.ZIndex = 5001
		valLbl.Parent = popup
		local slider = Instance.new("TextButton")
		slider.Size = UDim2.fromOffset(95, 14)
		slider.Position = UDim2.fromOffset(100, y)
		slider.BackgroundColor3 = THEME.BgButton
		slider.BorderSizePixel = 0
		slider.Text = ""
		slider.AutoButtonColor = false
		slider.ZIndex = 5001
		slider.Parent = popup
		Instance.new("UICorner", slider).CornerRadius = UDim.new(1, 0)
		local fill = Instance.new("Frame")
		fill.BackgroundColor3 = fillColor
		fill.BorderSizePixel = 0
		fill.Size = UDim2.new(getter() / 255, 0, 1, 0)
		fill.ZIndex = 5002
		fill.Parent = slider
		Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
		local dragging = false
		local function setFromX(x)
			local rel = math.clamp((x - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
			local v = math.floor(rel * 255 + 0.5)
			fill.Size = UDim2.new(rel, 0, 1, 0)
			valLbl.Text = tostring(v)
			setter(v); applyColor()
		end
		slider.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true; setFromX(input.Position.X)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				setFromX(input.Position.X)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
		end)
	end
	makeChannel("R", 30, function() return r end, function(v) r = v end, Color3.fromRGB(220,80,80))
	makeChannel("G", 58, function() return g end, function(v) g = v end, Color3.fromRGB(80,220,80))
	makeChannel("B", 86, function() return b end, function(v) b = v end, Color3.fromRGB(80,120,220))

	task.spawn(function()
		task.wait(0.2)
		if activeColorPicker ~= popup then return end
		colorPickerCloseConn = UserInputService.InputBegan:Connect(function(input, gpe)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then return end
			if gpe then return end
			destroyColorPicker()
		end)
	end)
end

