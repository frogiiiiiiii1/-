local function spawnBulletTracer()
	local now = tick()
	if now - S.lastTracerTime < 0.05 then return end
	S.lastTracerTime = now
	local camera = workspace.CurrentCamera
	if not camera then return end
	local camOrigin = camera.CFrame.Position
	local camDir = camera.CFrame.LookVector * 5000
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
	local vm = getViewModel()
	if vm then table.insert(ignore, vm) end
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	local result = workspace:Raycast(camOrigin, camDir, params)
	local hitPos = result and result.Position or (camOrigin + camDir)
	local origin = camOrigin + camDir.Unit * 2 + camera.CFrame.RightVector * 0.5 - Vector3.new(0, 0.3, 0)
	local p1 = Instance.new("Part")
	p1.Anchored = true; p1.CanCollide = false; p1.CanQuery = false
	p1.Transparency = 1; p1.Position = origin; p1.Parent = workspace
	local p2 = Instance.new("Part")
	p2.Anchored = true; p2.CanCollide = false; p2.CanQuery = false
	p2.Transparency = 1; p2.Position = hitPos; p2.Parent = workspace
	local a1 = Instance.new("Attachment", p1)
	local a2 = Instance.new("Attachment", p2)
	local beam = Instance.new("Beam")
	beam.Attachment0 = a1; beam.Attachment1 = a2
	beam.Color = ColorSequence.new(S.aim.bulletTracerColor)
	beam.Width0 = 0.3; beam.Width1 = 0.3
	beam.Brightness = 0.85
	beam.Transparency = NumberSequence.new(0)
	beam.LightEmission = 0; beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.TextureSpeed = 1.5; beam.TextureLength = 1
	beam.Texture = S.aim.bulletTracerTexture
	beam.Parent = workspace; beam.Name = "CheatBulletBeam"
	task.delay(S.aim.bulletTracerDelay, function()
		if beam then beam:Destroy() end
		if p1 then p1:Destroy() end
		if p2 then p2:Destroy() end
	end)
end

