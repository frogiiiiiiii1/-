	local function renderConfigList()
		for _, btn in ipairs(S.cfgButtons) do btn:Destroy() end
		S.cfgButtons = {}
		local names = listConfigFiles()
		if #names == 0 then
			local empty = Instance.new("TextLabel")
			empty.Size = UDim2.new(1, 0, 0, 20)
			empty.BackgroundTransparency = 1
			empty.Text = "Нет сохранённых конфигов"
			empty.TextColor3 = THEME.TextDim
			empty.Font = Enum.Font.Gotham
			empty.TextSize = 11
			empty.TextXAlignment = Enum.TextXAlignment.Center
			empty.ZIndex = 12
			empty.Parent = cfgScroll
			table.insert(S.cfgButtons, empty)
			return
		end
		for i, name in ipairs(names) do
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 26)
			btn.BackgroundColor3 = (S.selectedCfg == name) and THEME.Accent or THEME.BgButton
			btn.BorderSizePixel = 0
			btn.Text = name
			btn.TextColor3 = (S.selectedCfg == name) and THEME.TextOn or THEME.Text
			btn.Font = Enum.Font.GothamMedium
			btn.TextSize = 12
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.AutoButtonColor = false
			btn.LayoutOrder = i
			btn.ZIndex = 12
			btn.Parent = cfgScroll
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
			local pad = Instance.new("UIPadding", btn)
			pad.PaddingLeft = UDim.new(0, 10)
			btn.MouseButton1Click:Connect(function()
				S.selectedCfg = name
				S.configName = name
				cfgBox.Text = name
				renderConfigList()
			end)
			table.insert(S.cfgButtons, btn)
		end
	end

