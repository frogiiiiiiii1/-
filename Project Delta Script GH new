local function getServersFolder() return ReplicatedStorage:FindFirstChild("Servers") end

local function serverMatchesFilters(server)
	local loc = tostring(server:GetAttribute("ServerLocation"))
	local mapName = server:GetAttribute("MapName")
	local ver = server:GetAttribute("Ver")
	local timeStr = tostring(server:GetAttribute("TimeOfDay"))
	local hour = tonumber(string.match(timeStr, "^(%d%d)"))
	local count = tonumber(server:GetAttribute("PlayerCount"))
	local rank = "Default"
	if server:GetAttribute("Veteran") then rank = "Veteran"
	elseif server:GetAttribute("Premium") then rank = "Premium" end
	if S.SRV.nameFilter and S.SRV.nameFilter ~= "" then
		local n = server.Name:lower(); local f = S.SRV.nameFilter:lower()
		if #f > 2 then
			if not n:find(f, 1, true) then return false end
		else
			if n:sub(1, #f) ~= f and n:sub(-#f) ~= f then return false end
		end
	end
	if S.SRV.region ~= "Any" and loc ~= S.SRV.region then return false end
	if S.SRV.level ~= "All" and rank ~= S.SRV.level then return false end
	if S.SRV.map ~= "Any" and mapName ~= S.SRV.map then return false end
	if S.SRV.version ~= "Any" and ver ~= S.SRV.version then return false end
	if S.SRV.clock ~= "Any" and hour then
		if S.SRV.clock == "Day" and hour >= 12 then return false end
		if S.SRV.clock == "Night" and hour < 12 then return false end
	end
	if count and count < S.SRV.playerMax then return false end
	if count and count > S.SRV.playerMin then return false end
	return true
end

local function joinRandomServer()
	local folder = getServersFolder()
	if not folder then return false, "Servers folder не найден" end
	local matched = {}
	for _, server in ipairs(folder:GetChildren()) do
		if serverMatchesFilters(server) then table.insert(matched, server) end
	end
	if #matched == 0 then return false, "Сервер не найден" end
	local pick = matched[math.random(1, #matched)]
	local placeId = pick:GetAttribute("PlaceId") or game.PlaceId
	local jobId = pick:GetAttribute("JobId")
	local ok, err = pcall(function()
		TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
	end)
	if not ok then return false, tostring(err) end
	return true, "Телепорт..."
end

-- CONFIG
local function readIndex()
	local names = {}
	if not isfile or not readfile then return names end
	local ok, text = pcall(function()
		if isfile(CFG.INDEX) then return readfile(CFG.INDEX) end
	end)
	if not ok or not text then return names end
	for line in text:gmatch("[^\r\n]+") do
		local n = line:match("^%s*(.-)%s*$")
		if n ~= "" then table.insert(names, n) end
	end
	return names
end

local function writeIndex(names)
	if not writefile then return end
	pcall(function() writefile(CFG.INDEX, table.concat(names, "\n")) end)
end

local function addToIndex(name)
	local names = readIndex()
	for _, n in ipairs(names) do if n == name then return end end
	table.insert(names, name); table.sort(names); writeIndex(names)
end

local function removeFromIndex(name)
	local names = readIndex()
	local filtered = {}
	for _, n in ipairs(names) do if n ~= name then table.insert(filtered, n) end end
	writeIndex(filtered)
end

local function listConfigFiles()
	local names, seen = {}, {}
	for _, n in ipairs(readIndex()) do
		if not seen[n] then seen[n] = true; table.insert(names, n) end
	end
	local ok, files = pcall(function() if listfiles then return listfiles() end end)
	if ok and files then
		for _, path in ipairs(files) do
			local p = tostring(path):gsub("\\", "/")
			local fname = p:match("([^/]+)$") or p
			if fname:sub(1, #CFG.PREFIX) == CFG.PREFIX and fname:sub(-4) == ".txt" then
				local cfgName = fname:sub(#CFG.PREFIX + 1, -5)
				if cfgName ~= "" and not seen[cfgName] then
					seen[cfgName] = true; table.insert(names, cfgName)
				end
			end
		end
	end
	table.sort(names)
	return names
end

local function deleteConfig(name)
	if not delfile then return false end
	local ok = pcall(delfile, CFG.PREFIX .. name .. ".txt")
	if ok then removeFromIndex(name) end
	return ok
end

local function keyCodeFromName(name)
	if not name or name == "" then return nil end
	local ok, code = pcall(function() return Enum.KeyCode[name] end)
	if ok and code then return code end
	return nil
end

local function userInputTypeFromName(name)
	if not name or name == "" then return nil end
	local ok, code = pcall(function() return Enum.UserInputType[name] end)
	if ok and code then return code end
	return nil
end

local function buildConfigTable()
	local data = {}
	for name, api in pairs(S.toggles) do
		if api and api.getEnabled then data["toggle." .. name] = api.getEnabled() and "true" or "false" end
	end
	for k, v in pairs(S.espColors) do
		data["color." .. k] = tostring(v.R) .. "|" .. tostring(v.G) .. "|" .. tostring(v.B)
	end
	for k, v in pairs(S.npcColors) do
		data["npcColor." .. k] = tostring(v.R) .. "|" .. tostring(v.G) .. "|" .. tostring(v.B)
	end
	for label, api in pairs(S.colorRows) do
		if api and api.get then
			local c = api.get()
			data["colorRow." .. label] = tostring(c.R) .. "|" .. tostring(c.G) .. "|" .. tostring(c.B)
		end
	end
	for label, api in pairs(S.sliders) do
		if api and api.get then data["slider." .. label] = tostring(api.get()) end
	end
	for label, api in pairs(S.dropdowns) do
		if api and api.get then data["dropdown." .. label] = tostring(api.get()) end
	end
	data["keybind.zoom"] = keyName(S.zoomKey)
	data["keybind.thirdPerson"] = keyName(S.thirdPerson.keybind)
	data["keybind.inventory"] = keyName(S.INV.keybind)
	data["keybind.aim"] = keyName(S.aim.keybind)
	data["keybind.aimBindType"] = S.aim.bindType
	data["keybind.aimBindMouse"] = tostring(S.aim.bindMouse):gsub("Enum.UserInputType%.", "")
	data["aim.mode"] = S.aim.mode
	data["menuApp.transparency"] = tostring(S.menuApp.transparency)
	data["menuApp.bgColor"] = tostring(S.menuApp.bgColor.R) .. "|" .. tostring(S.menuApp.bgColor.G) .. "|" .. tostring(S.menuApp.bgColor.B)
	data["menuApp.borderColor"] = tostring(S.menuApp.borderColor.R) .. "|" .. tostring(S.menuApp.borderColor.G) .. "|" .. tostring(S.menuApp.borderColor.B)
	data["menuApp.titleColor"] = tostring(S.menuApp.titleColor.R) .. "|" .. tostring(S.menuApp.titleColor.G) .. "|" .. tostring(S.menuApp.titleColor.B)
	return data
end

local function serializeConfig(data)
	local lines = {}
	for k, v in pairs(data) do table.insert(lines, k .. "=" .. v) end
	table.sort(lines)
	return table.concat(lines, "\n")
end

local function parseConfig(text)
	local data = {}
	for line in text:gmatch("[^\r\n]+") do
		local k, v = line:match("^(.-)=(.*)$")
		if k and v then data[k] = v end
	end
	return data
end

local function loadConfigFromTable(data)
	local function parseBool(s) return s == "true" end
	local function parseColor(s)
		if typeof(s) ~= "string" then return nil end
		local r, g, b = s:match("([%d%.]+)|([%d%.]+)|([%d%.]+)")
		if r and g and b then
			local rn, gn, bn = tonumber(r), tonumber(g), tonumber(b)
			if rn and gn and bn then return Color3.new(rn, gn, bn) end
		end
		return nil
	end
	local keys = {}
	for k in pairs(data) do table.insert(keys, k) end
	table.sort(keys)
	for _, k in ipairs(keys) do
		local v = data[k]
		local prefix, key = k:match("^(.-)%.(.+)$")
		local ok, err = pcall(function()
			if prefix == "color" and S.espColors[key] ~= nil then
				local c = parseColor(v); if c then S.espColors[key] = c end
			elseif prefix == "npcColor" and S.npcColors[key] ~= nil then
				local c = parseColor(v); if c then S.npcColors[key] = c end
			elseif prefix == "colorRow" then
				local api = S.colorRows[key]
				if api and api.set then
					local c = parseColor(v); if c then api.set(c) end
				end
			elseif prefix == "slider" then
				local api = S.sliders[key]
				if api and api.set then api.set(tonumber(v) or 0) end
			elseif prefix == "dropdown" then
				local api = S.dropdowns[key]
				if api and api.set then api.set(v) end
			elseif prefix == "keybind" then
				if key == "aimBindType" then
					if v == "Key" or v == "Mouse" then S.aim.bindType = v end
				elseif key == "aimBindMouse" then
					local ut = userInputTypeFromName(v)
					if ut then S.aim.bindMouse = ut end
				else
					local code = keyCodeFromName(v)
					if code then
						if key == "zoom" then S.zoomKey = code
						elseif key == "thirdPerson" then S.thirdPerson.keybind = code
						elseif key == "inventory" then S.INV.keybind = code
						elseif key == "aim" then S.aim.keybind = code end
					end
				end
			elseif prefix == "aim" then
				if key == "mode" then
					if v == "Lock" or v == "Silent" then S.aim.mode = v end
				end
			elseif prefix == "menuApp" then
				if key == "transparency" then
					S.menuApp.transparency = tonumber(v) or 0
				elseif key == "bgColor" then
					local c = parseColor(v); if c then S.menuApp.bgColor = c end
				elseif key == "borderColor" then
					local c = parseColor(v); if c then S.menuApp.borderColor = c end
				elseif key == "titleColor" then
					local c = parseColor(v); if c then S.menuApp.titleColor = c end
				end
			end
		end)
		if not ok then warn("[CHEAT] Failed to load '" .. k .. "': " .. tostring(err)) end
	end
	for _, k in ipairs(keys) do
		local v = data[k]
		local prefix, key = k:match("^(.-)%.(.+)$")
		if prefix == "toggle" then
			local api = S.toggles[key]
			if api and api.setEnabled then
				local ok, err = pcall(api.setEnabled, parseBool(v))
				if not ok then warn("[CHEAT] Failed to load toggle '" .. key .. "': " .. tostring(err)) end
			else warn("[CHEAT] Toggle not found: " .. key) end
		end
	end
	if S.keybindUI.zoom then S.keybindUI.zoom.Text = "Zoom Key  ·  " .. keyName(S.zoomKey) end
	if S.keybindUI.aim then
		local disp = S.aim.bindType == "Mouse"
			and (tostring(S.aim.bindMouse):gsub("Enum.UserInputType%.", ""))
			or keyName(S.aim.keybind)
		S.keybindUI.aim.Text = "Aim Keybind  ·  " .. disp
	end
	if S.keybindUI.thirdPerson then
		S.keybindUI.thirdPerson.Text = "Third Person Keybind  ·  " .. keyName(S.thirdPerson.keybind)
	end
	if S.keybindUI.inventory then
		S.keybindUI.inventory.Text = "Inventory Keybind  ·  " .. keyName(S.INV.keybind)
	end
	applyMenuAppearance()
	for _, p in ipairs(Players:GetPlayers()) do
		if S.espData[p] and not anyFlagOn() then removeESP(p) end
	end
	rebuildESP()
end

local function saveConfig(name)
	local path = CFG.PREFIX .. name .. ".txt"
	local data = buildConfigTable()
	local text = serializeConfig(data)
	if not writefile then notify("Config Error", "writefile недоступен", 5); return false end
	local ok, err = pcall(function() writefile(path, text) end)
	if ok then addToIndex(name); notify("Config", "Saved: " .. name, 3); return true
	else notify("Config Error", tostring(err), 5); return false end
end

local function loadConfig(name)
	local path = CFG.PREFIX .. name .. ".txt"
	if not readfile or not isfile then
		notify("Config Error", "readfile/isfile недоступны", 5); return false
	end
	local ok, exists = pcall(isfile, path)
	if not ok or not exists then notify("Config", "Файл не найден: " .. name, 3); return false end
	local ok2, text = pcall(readfile, path)
	if not ok2 or not text then notify("Config Error", "Не удалось прочитать", 5); return false end
	local data = parseConfig(text)
	loadConfigFromTable(data)
	notify("Config", "Loaded: " .. name, 3)
	return true
end

local function unloadAll()
	S.new.instantEquip = false; S.new.omniSprint = false
	S.new.corpseESP = false; S.new.containerESP = false
	S.new.hideServerInfo = false; S.new.skyChanger = false
	S.new.gasMaskSound = false
	if S.visorOriginals.saved then
		local se = findScreenEffects()
		if se then
			if se:FindFirstChild("Visor") then se.Visor.Visible = S.visorOriginals.visor end
			if se:FindFirstChild("Mask") then se.Mask.Visible = S.visorOriginals.mask end
			if se:FindFirstChild("HelmetMask") then se.HelmetMask.Visible = S.visorOriginals.helmet end
			if se:FindFirstChild("Flashbang") then se.Flashbang.Visible = S.visorOriginals.flash end
		end
	end
	S.new.noVisor = false
	local se = findScreenEffects()
	if se then
		local mask = se:FindFirstChild("Mask")
		local gp5 = mask and mask:FindFirstChild("GP5")
		if gp5 then
			for _, s in ipairs(gp5:GetChildren()) do
				if s:IsA("Sound") then s.Volume = 1 end
			end
		end
	end
	local di = workspace:FindFirstChild("DroppedItems")
	if di then
		for _, c in ipairs(di:GetChildren()) do
			local t = c:FindFirstChild("CheatCorpseTag"); if t then t:Destroy() end
		end
	end
	local cont = workspace:FindFirstChild("Containers")
	if cont then
		for _, c in ipairs(cont:GetDescendants()) do
			local t = c:FindFirstChild("CheatContainerTag"); if t then t:Destroy() end
		end
	end
	for _, c in pairs(S.newConns) do pcall(function() c:Disconnect() end) end
	for _, c in pairs(S.espConns) do pcall(function() c:Disconnect() end) end
	if S.visorWatch then S.visorWatch:Disconnect() end
	for _, gui in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
		if gui.Name == "ServerInfo" then
			local frame = gui:FindFirstChild("Frame")
			local si = frame and frame:FindFirstChild("serverInfo")
			if si then si.Visible = true end
		end
	end
	UserInputService.MouseIconEnabled = true
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	if ScreenGui then ScreenGui:Destroy() end
	if InvGui then InvGui:Destroy() end
	print("[CHEAT] Unloaded.")
end

