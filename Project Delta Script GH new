	Knob.BorderSizePixel = 0
	Knob.ZIndex = 13
	Knob.Parent = Pill
	Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)
	local state = false
	local function render(s)
		state = s
		TweenService:Create(Btn, TweenInfo.new(0.15), {
			BackgroundColor3 = s and THEME.BgButtonOn or THEME.BgButton }):Play()
		TweenService:Create(Pill, TweenInfo.new(0.15), {
			BackgroundColor3 = s and THEME.Accent or THEME.PillOff }):Play()
		TweenService:Create(Knob, TweenInfo.new(0.15), {
			BackgroundColor3 = s and THEME.TextOn or Color3.fromRGB(220,220,220),
			Position = s and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6) }):Play()
		Label.TextColor3 = s and THEME.TextOn or THEME.Text
	end
	Btn.MouseButton1Click:Connect(function()
		render(not state)
		if callback.onToggle then callback.onToggle(state) end
	end)
	render(false)
	local api = {}
	api.setEnabled = function(v)
		if v == state then return end
		render(v)
		if callback.onToggle then callback.onToggle(v) end
	end
	api.getEnabled = function() return state end
	S.toggles[name] = api
	return api
end

