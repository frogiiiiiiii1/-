	local aimPos = target.part.Position - Vector3.new(0, S.aim.yOffset, 0)
	if S.aim.prediction then
		local hrp = target.model:FindFirstChild("HumanoidRootPart")
		if hrp then
			local myPos = vmHRP.Position
			local dist = (aimPos - myPos).Magnitude
			local mv = getMuzzleVelocity()
			local travel = dist / math.max(mv, 100) * 1.33
			local vel = hrp.AssemblyLinearVelocity
			aimPos = Vector3.new(
				target.part.Position.X + vel.X * travel,
				aimPos.Y,
				target.part.Position.Z + vel.Z * travel)
		end
	end
	vmHRP.CFrame = CFrame.new(vmHRP.Position, aimPos)
end

