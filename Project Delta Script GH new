local function applyContainerESP(enable)
	S.new.containerESP = enable
	local cont = workspace:FindFirstChild("Containers")
	if not cont then return end
	local function walk(folder)
		for _, c in ipairs(folder:GetChildren()) do
			if c:IsA("Folder") then walk(c)
			elseif CONTAINER_WHITELIST[c.Name] then
				if enable then
					if not c:FindFirstChild("CheatContainerTag") then
						local bb = containerTemplate:Clone()
						bb.Label.Text = c.Name .. " | Container"; bb.Parent = c
					end
				else
					local tag = c:FindFirstChild("CheatContainerTag"); if tag then tag:Destroy() end
				end
			end
		end
	end
	walk(cont)
	if enable then
		if S.newConns.containerAdded then S.newConns.containerAdded:Disconnect() end
		S.newConns.containerAdded = cont.DescendantAdded:Connect(function(c)
			if S.new.containerESP and CONTAINER_WHITELIST[c.Name]
				and not c:FindFirstChild("CheatContainerTag") then
				task.wait(0.1)
				if c and c.Parent and S.new.containerESP then
					local bb = containerTemplate:Clone()
					bb.Label.Text = c.Name .. " | Container"; bb.Parent = c
				end
			end
		end)
	else
		if S.newConns.containerAdded then S.newConns.containerAdded:Disconnect(); S.newConns.containerAdded = nil end
	end
end

