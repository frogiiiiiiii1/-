local function getIconForItem(itemName)
	local list = ReplicatedStorage:FindFirstChild("ItemsList")
	if not list then return nil end
	local item = list:FindFirstChild(itemName)
	if not item then return nil end
	local props = item:FindFirstChild("ItemProperties")
	if not props then return nil end
	local icon = props:FindFirstChild("ItemIcon")
	if icon and icon:IsA("Decal") then return icon.Texture end
	if icon and icon:IsA("ImageLabel") then return icon.Image end
	return nil
end

local function getInventoryContainer(target)
	if target:FindFirstChild("Humanoid") then return target:FindFirstChild("Inventory") end
	local players = ReplicatedStorage:FindFirstChild("Players")
	if not players then return nil end
	local pEntry = players:FindFirstChild(target.Name)
	if not pEntry then return nil end
	return pEntry:FindFirstChild("Inventory")
end

local function calculateInventoryValue(inv)
	local total = 0
	local list = ReplicatedStorage:FindFirstChild("ItemsList")
	if not list then return 0 end
	for _, slot in ipairs(inv:GetChildren()) do
		local slotAttr = slot:GetAttribute("Slot")
		if type(slotAttr) == "string" and slotAttr:find("Clothing") then
			local sub = slot:FindFirstChild("Inventory")
			if sub then
				for _, stack in ipairs(sub:GetChildren()) do
					local item = list:FindFirstChild(stack.Name)
					if item then
						local props = item:FindFirstChild("ItemProperties")
						if props then
							if stack.Name == "Rubles" then
								total = total + (stack:GetAttribute("Amount") or 1)
							else
								local price = props:GetAttribute("Price") or 1
								if price >= 10 then
									local itype = props:GetAttribute("ItemType")
									if itype == "Extra" then price = price * 0.4
									elseif itype == "Ammo" then price = price * (stack:GetAttribute("Amount") or 1) * 0.7
									elseif itype == "Clothing" then price = price * 0.35
									elseif itype == "Medical" then price = price * 0.75
									elseif itype == "Barter" then price = price * 0.4 end
								end
								total = total + price
							end
						end
					end
				end
			end
		end
	end
	return math.floor(total)
end

local function renderInventory(target)
	if not target then return end
	clearInvUI()
	local inv = getInventoryContainer(target)
	if not inv then targetInfoLbl.Text = target.Name .. " (нет инвентаря)"; return end
	local weaponSlot = 1; local clothingSlot = 4; local attachIndex = 0
	for _, item in ipairs(inv:GetChildren()) do
		local slotAttr = item:GetAttribute("Slot")
		if type(slotAttr) == "string" then
			if slotAttr:find("Clothing") then
				local icon = getIconForItem(item.Name)
				if icon and clothingSlot <= 12 then
					S.INV.hotbarSlots[clothingSlot].Image = icon
					clothingSlot = clothingSlot + 1
				end
			elseif item:FindFirstChild("Attachments") then
				local icon = getIconForItem(item.Name)
				if icon and weaponSlot <= 12 then
					S.INV.hotbarSlots[weaponSlot].Image = icon
					weaponSlot = weaponSlot + 1
				end
				for _, att in ipairs(item.Attachments:GetChildren()) do
					local attSlot = att:GetAttribute("Slot")
					local attIcon = getIconForItem(att.Name)
					local idx = nil
					if attSlot == "Magazine" then idx = 1
					elseif attSlot == "Sight" then idx = 2
					elseif attSlot == "Muzzle" then idx = 3
					elseif attSlot == "Extra" then idx = 4 end
					if idx and attIcon and (attachIndex + idx) <= 12 then
						S.INV.attachmentSlots[attachIndex + idx].Image = attIcon
					end
				end
				attachIndex = attachIndex + 4
			end
		end
	end
	if S.INV.showFull then
		local idx = 1
		for _, item in ipairs(inv:GetChildren()) do
			local sub = item:FindFirstChild("Inventory")
			if sub and item.Name ~= "KeyChain" then
				for _, stack in ipairs(sub:GetChildren()) do
					if idx > 54 then break end
					local icon = getIconForItem(stack.Name)
					if icon then
						S.INV.fullSlots[idx].Image = icon
						local amount = stack:GetAttribute("Amount") or 1
						if amount >= 1000 then
							S.INV.fullAmounts[idx].Text = tostring(math.floor(amount / 1000)) .. "K"
						else S.INV.fullAmounts[idx].Text = "x" .. tostring(amount) end
					end
					idx = idx + 1
				end
			end
		end
	end
	local parts = { target.Name }
	if S.INV.showValue then
		local cached = S.INV.valueCache[target.Name]
		local now = tick()
		local value
		if cached and (now - cached.time) < 3 then
			value = cached.value
		else
			value = calculateInventoryValue(inv)
			S.INV.valueCache[target.Name] = { value = value, time = now }
		end
		table.insert(parts, "$" .. tostring(value))
	end
	targetInfoLbl.Text = table.concat(parts, "  ·  ")
end

local function findNearestInvTarget()
	local camera = workspace.CurrentCamera
	if not camera then return nil end
	local vp = camera.ViewportSize
	local screenCenter = Vector2.new(vp.X / 2, vp.Y / 2)
	local maxDist = math.min(vp.X, vp.Y) / 2
	local nearest, nearestDist = nil, math.huge
	local function checkModel(model, headPart)
		if not headPart or not headPart.Parent then return end
		local sp, onScreen = camera:WorldToViewportPoint(headPart.Position)
		if not onScreen or sp.Z <= 0 then return end
		local dist = (Vector2.new(sp.X, sp.Y) - screenCenter).Magnitude
		if dist < maxDist and dist < nearestDist then
			nearestDist = dist; nearest = model
		end
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			checkModel(plr, plr.Character:FindFirstChild("Head"))
		end
	end
	if S.INV.checkCorpses then
		local di = workspace:FindFirstChild("DroppedItems")
		if di then
			for _, corpse in ipairs(di:GetChildren()) do
				if corpse:FindFirstChild("Humanoid") and corpse:FindFirstChild("Head") then
					checkModel(corpse, corpse.Head)
				end
			end
		end
	end
	return nearest
end

